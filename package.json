{
  "name": "axon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/validate-course.mjs --write-ready && vite",
    "build": "node scripts/validate-course.mjs --write-ready && vite build",
    "preview": "vite preview",
    "test": "node --test tests/core.test.mjs && node scripts/validate-course.mjs",
    "dev:full": "npm run build && wrangler pages dev dist --d1 DB=axon-local --compatibility-date=2024-11-01",
    "test:api": "node tests/api-smoke.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.11"
  }
}
