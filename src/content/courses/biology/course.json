  "ia": {
    "name": "Scientific investigation",
    "max": 24,
    "weight": 20,
    "limit": "3,000 words",
    "criteria": [
      {
        "id": "rd",
        "name": "Research design",
        "max": 6,
        "look": [
          "A focused, relevant research question with clearly defined variables",
          "Background that explains the biology and why the question matters",
          "A method that is detailed enough to repeat, with controlled variables and how they are controlled",
          "Enough data (range, increments, repeats) to answer the question",
          "Safety, ethical and environmental issues considered where relevant"
        ]
      },
      {
        "id": "da",
        "name": "Data analysis",
        "max": 6,
        "look": [
          "Raw data recorded clearly with units and uncertainties",
          "Appropriate processing (means, SD, rates, statistical test) shown with a worked example",
          "Graphs that suit the data, with labelled axes, units and error bars",
          "Uncertainties carried through and their impact considered"
        ]
      },
      {
        "id": "co",
        "name": "Conclusion",
        "max": 6,
        "look": [
          "A conclusion that directly answers the research question",
          "Justified with the processed data, quoting values",
          "Compared with accepted scientific context or published research",
          "Acknowledges how far the data support the conclusion"
        ]
      },
      {
        "id": "ev",
        "name": "Evaluation",
        "max": 6,
        "look": [
          "Specific methodological weaknesses identified and their effect on the results explained",
          "Distinguishes systematic and random errors",
          "Realistic, specific improvements linked to each weakness",
          "Sensible extensions to the investigation"
        ]
      }
    ],
    "checklist": [
      "Research question names the independent and dependent variables, with units/range",
      "At least 5 levels of the independent variable, with enough repeats for each",
      "Uncertainties stated for every measuring instrument",
      "A worked example for each calculation",
      "Graphs have titles, labelled axes with units, and error bars",
      "Statistical test chosen and justified (e.g. t-test, chi-squared, correlation)",
      "Conclusion quotes processed values and refers back to the research question",
      "Weaknesses are specific to YOUR method, each with a realistic improvement",
      "Report is under 3,000 words (excluding tables, graphs, references)",
      "All sources referenced consistently"
    ]
  },
  "examTips": [
    "Obey the command term: \"describe\" the trend, \"explain\" with a mechanism, \"evaluate\" with strengths and limitations.",
    "Quote data with units: \"increased from 12 to 30 mg\" beats \"increased a lot\".",
    "One mark ≈ one distinct point: a 4-mark question wants four separate, precise ideas.",
    "Correlation ≠ causation: say what the data suggest, not what they prove.",
    "Use precise terms: enzymes denature (they don't die); molecules, not \"particles\"; ATP releases energy, it isn't \"made\"."
  ],
