          "terms": [
            "math-ai-5.1-derivative",
            "math-ai-5.1-increasing-decreasing",
            "math-ai-5.1-stationary-point"
          ]
        },
        {
          "id": "math-ai-5.1-1-q10",
          "type": "order",
          "prompt": "Put the steps for finding a tangent in order.",
