{
  "id": "math-ai-5.1",
  "code": "SL 5.1–5.4, 5.6–5.7",
  "unit": "5",
  "title": "Differentiation and optimisation",
  "level": "SL",
  "summary": "The derivative as a gradient and rate of change, differentiating axⁿ, tangents and normals, increasing and decreasing functions, stationary points and optimisation problems.",
  "keyterms": [
    {
      "id": "math-ai-5.1-derivative",
      "term": "Derivative",
      "definition": "f′(x) or dy/dx: the gradient function, giving the rate of change of y with respect to x.",
      "hl": false
    },
    {
      "id": "math-ai-5.1-limit",
      "term": "Limit",
      "definition": "The value approached as h → 0 in the gradient of a chord; it defines the derivative.",
      "hl": false
    },
    {
      "id": "math-ai-5.1-power-rule",
      "term": "Power rule",
      "definition": "If f(x) = axⁿ then f′(x) = anxⁿ⁻¹ (n an integer).",
      "hl": false
    },
    {
      "id": "math-ai-5.1-tangent",
      "term": "Tangent",
      "definition": "A line touching a curve at a point, with gradient equal to f′(x) there.",
      "hl": false
    },
    {
      "id": "math-ai-5.1-normal",
      "term": "Normal",
      "definition": "The line perpendicular to the tangent at a point; gradient −1/f′(x).",
      "hl": false
    },
    {
      "id": "math-ai-5.1-increasing-decreasing",
      "term": "Increasing / decreasing",
      "definition": "f is increasing where f′(x) > 0 and decreasing where f′(x) < 0.",
      "hl": false
    },
    {
      "id": "math-ai-5.1-stationary-point",
      "term": "Stationary point",
      "definition": "A point where f′(x) = 0.",
      "hl": false
    },
    {
      "id": "math-ai-5.1-local-maximum",
      "term": "Local maximum",
      "definition": "A stationary point where f′ changes from positive to negative.",
      "hl": false
    },
    {
      "id": "math-ai-5.1-local-minimum",
      "term": "Local minimum",
      "definition": "A stationary point where f′ changes from negative to positive.",
      "hl": false
    },
    {
      "id": "math-ai-5.1-optimisation",
      "term": "Optimisation",
      "definition": "Finding the maximum or minimum value of a quantity, e.g. by solving f′(x) = 0.",
      "hl": false
    }
  ],
  "lessons": [
    {
      "id": "math-ai-5.1-1",
      "title": "Derivatives, tangents and normals",
      "hl": false,
      "questions": [
