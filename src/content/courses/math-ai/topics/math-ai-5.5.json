{
  "id": "math-ai-5.5",
  "code": "SL 5.5, 5.8",
  "unit": "5",
  "title": "Integration and the trapezoidal rule",
  "level": "SL",
  "summary": "Integration as anti-differentiation, finding constants from boundary conditions, definite integrals for areas, and estimating areas with the trapezoidal rule.",
  "keyterms": [
    {
      "id": "math-ai-5.5-antiderivative",
      "term": "Antiderivative",
      "definition": "A function whose derivative is f(x); the indefinite integral ∫f(x) dx.",
      "hl": false
    },
    {
      "id": "math-ai-5.5-constant-of-integration",
      "term": "Constant of integration",
      "definition": "C in ∫f(x) dx = F(x) + C, needed because constants differentiate to 0.",
      "hl": false
    },
    {
      "id": "math-ai-5.5-boundary-condition",
      "term": "Boundary condition",
      "definition": "A known point on the curve, used to find C.",
      "hl": false
    },
    {
      "id": "math-ai-5.5-definite-integral",
      "term": "Definite integral",
      "definition": "∫ₐᵇ f(x) dx: a number, equal to the area under y = f(x) from a to b when f(x) ≥ 0.",
      "hl": false
    },
    {
      "id": "math-ai-5.5-area-under-curve",
      "term": "Area under a curve",
      "definition": "The region between the curve, the x-axis and the lines x = a and x = b.",
      "hl": false
    },
    {
      "id": "math-ai-5.5-trapezoidal-rule",
      "term": "Trapezoidal rule",
      "definition": "∫ₐᵇ y dx ≈ (h/2)[y₀ + yₙ + 2(y₁ + … + yₙ₋₁)].",
      "hl": false
    },
    {
      "id": "math-ai-5.5-strip-width",
      "term": "Strip width",
      "definition": "h = (b − a)/n, the width of each trapezium.",
      "hl": false
    },
    {
      "id": "math-ai-5.5-overestimate",
      "term": "Over/underestimate",
      "definition": "The trapezoidal rule overestimates for curves that are concave up and underestimates for concave down.",
      "hl": false
    }
  ],
  "lessons": [
    {
