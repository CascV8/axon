{
  "id": "math-ai-2.7",
  "code": "AHL 2.7–2.10",
  "unit": "2",
  "title": "Transformations, further models and linearisation",
  "level": "HL",
  "summary": "Composite and inverse functions, transformations of graphs, logistic and logarithmic models, and straightening data with semi-log and log-log graphs.",
  "keyterms": [
    {
      "id": "math-ai-2.7-composite-function",
      "term": "Composite function",
      "definition": "(f∘g)(x) = f(g(x)): apply g first, then f.",
      "hl": true
    },
    {
      "id": "math-ai-2.7-domain-restriction",
      "term": "Domain restriction",
      "definition": "Limiting the domain so a function is one-to-one and has an inverse.",
      "hl": true
    },
    {
      "id": "math-ai-2.7-translation",
      "term": "Translation",
      "definition": "y = f(x − a) + b shifts the graph a units right and b units up.",
      "hl": true
    },
    {
      "id": "math-ai-2.7-vertical-stretch",
      "term": "Vertical stretch",
      "definition": "y = pf(x) stretches the graph parallel to the y-axis with scale factor p.",
      "hl": true
    },
    {
      "id": "math-ai-2.7-horizontal-stretch",
      "term": "Horizontal stretch",
      "definition": "y = f(qx) stretches the graph parallel to the x-axis with scale factor 1/q.",
      "hl": true
    },
    {
      "id": "math-ai-2.7-reflection",
      "term": "Reflection",
      "definition": "y = −f(x) reflects in the x-axis; y = f(−x) reflects in the y-axis.",
      "hl": true
    },
    {
      "id": "math-ai-2.7-logistic-model",
      "term": "Logistic model",
      "definition": "f(x) = L/(1 + Ce^(−kx)): growth that slows as it approaches a limit L.",
      "hl": true
    },
    {
      "id": "math-ai-2.7-carrying-capacity",
      "term": "Carrying capacity",
      "definition": "L, the upper limit (horizontal asymptote) of a logistic model.",
      "hl": true
    },
    {
      "id": "math-ai-2.7-natural-log-model",
      "term": "Natural logarithmic model",
      "definition": "f(x) = a + b ln x: keeps increasing but ever more slowly.",
      "hl": true
    },
    {
      "id": "math-ai-2.7-semi-log-graph",
      "term": "Semi-log graph",
      "definition": "A graph of log y against x; exponential data y = kaˣ appear as a straight line.",
      "hl": true
    },
    {
      "id": "math-ai-2.7-log-log-graph",
      "term": "Log-log graph",
      "definition": "A graph of log y against log x; power data y = kxⁿ appear as a straight line with gradient n.",
      "hl": true
    },
    {
      "id": "math-ai-2.7-linearisation",
      "term": "Linearisation",
      "definition": "Transforming variables so that data lie on a straight line, allowing linear regression.",
      "hl": true
    }
  ],
  "lessons": [
    {
      "id": "math-ai-2.7-1",
      "title": "Composites, inverses and transformations",
      "hl": true,
      "questions": [
        {
          "id": "math-ai-2.7-1-q01",
          "type": "mcq",
          "prompt": "f(x) = 2x + 1 and g(x) = x². Find (f∘g)(3).",
          "options": [
            "49",
            "19",
            "10",
            "13"
          ],
          "answer": 1,
          "explanation": "g(3) = 9 first, then f(9) = 19. (g∘f)(3) would be 49.",
          "terms": [
            "math-ai-2.7-composite-function"
          ]
        },
        {
          "id": "math-ai-2.7-1-q02",
          "type": "tf",
          "statement": "(f∘g)(x) means apply g first, then f.",
          "answer": true,
          "explanation": "f(g(x)): the inner function acts first.",
          "terms": [
            "math-ai-2.7-composite-function"
          ]
        },
        {
          "id": "math-ai-2.7-1-q03",
          "type": "mcq",
          "prompt": "y = f(x − 3) + 2 is a translation of y = f(x) by:",
          "options": [
            "3 left and 2 up",
            "3 right and 2 down",
            "2 right and 3 up",
            "3 right and 2 up"
          ],
          "answer": 3,
          "explanation": "f(x − a) moves right by a; adding b outside moves up by b.",
          "terms": [
            "math-ai-2.7-translation"
          ]
        },
        {
          "id": "math-ai-2.7-1-q04",
          "type": "fill",
          "text": "y = f(2x) is a horizontal stretch with scale factor ___.",
          "answer": "½",
          "bank": [
            "2",
            "−2",
            "½",
            "4"
          ],
          "explanation": "Inside changes act the opposite way: f(qx) has scale factor 1/q.",
          "terms": [
            "math-ai-2.7-horizontal-stretch"
          ]
        },
        {
          "id": "math-ai-2.7-1-q05",
          "type": "mcq",
          "prompt": "y = −f(x) is a reflection of y = f(x) in:",
          "options": [
            "the y-axis",
            "the x-axis",
            "the line y = x",
            "the origin only"
          ],
          "answer": 1,
          "explanation": "All y-values change sign, flipping the graph over the x-axis.",
          "terms": [
            "math-ai-2.7-reflection"
          ]
        },
        {
          "id": "math-ai-2.7-1-q06",
          "type": "tf",
          "statement": "y = 3f(x) is a vertical stretch with scale factor 3.",
          "answer": true,
          "explanation": "Every y-value is multiplied by 3.",
          "terms": [
            "math-ai-2.7-vertical-stretch"
          ]
        },
        {
          "id": "math-ai-2.7-1-q07",
          "type": "mcq",
          "prompt": "f(x) = (x − 2)², x ≥ 2. Find f⁻¹(x).",
          "options": [
            "√x − 2",
            "2 − √x",
            "(x + 2)²",
            "2 + √x"
          ],
          "answer": 3,
          "explanation": "x = (y − 2)² gives y = 2 ± √x; the restriction y ≥ 2 picks 2 + √x.",
          "terms": [
            "math-ai-2.7-domain-restriction"
          ]
        },
        {
          "id": "math-ai-2.7-1-q08",
          "type": "match",
          "prompt": "Match each transformation of y = f(x) to its effect.",
          "pairs": [
            {
              "left": "f(x) + 4",
              "right": "translate up 4"
            },
            {
              "left": "f(x + 4)",
              "right": "translate left 4"
            },
            {
              "left": "f(−x)",
              "right": "reflect in the y-axis"
            },
            {
              "left": "¼f(x)",
              "right": "vertical stretch, scale factor ¼"
            }
          ],
          "explanation": "Changes outside f act vertically as written; changes inside act horizontally and in reverse.",
          "terms": [
            "math-ai-2.7-translation",
            "math-ai-2.7-reflection",
            "math-ai-2.7-vertical-stretch"
          ]
        },
        {
          "id": "math-ai-2.7-1-q09",
          "type": "fill",
          "text": "f(x) = x + 3 and g(x) = 2x. Then (g∘f)(x) = 2x + ___.",
          "answer": "6",
          "bank": [
            "3",
            "6",
            "5",
            "9"
          ],
          "explanation": "g(f(x)) = 2(x + 3) = 2x + 6.",
          "terms": [
            "math-ai-2.7-composite-function"
          ]
        },
        {
          "id": "math-ai-2.7-1-q10",
          "type": "order",
          "prompt": "Put the steps in order to transform y = f(x) into y = 2f(x) + 1.",
          "items": [
            "Start with y = f(x)",
            "Apply a vertical stretch with scale factor 2",
            "Translate up 1 unit"
          ],
          "explanation": "Stretch before translating; translating first would give 2(f(x) + 1) = 2f(x) + 2.",
          "terms": [
            "math-ai-2.7-vertical-stretch",
            "math-ai-2.7-translation"
          ]
        }
      ]
    },
    {
      "id": "math-ai-2.7-2",
      "title": "Further models and linearising data",
      "hl": true,
      "questions": [
        {
          "id": "math-ai-2.7-2-q01",
          "type": "mcq",
          "prompt": "A population is P(t) = 500/(1 + 9e^(−0.4t)). Find P(0).",
          "options": [
            "50",
            "500",
            "55.6",
            "450"
          ],
          "answer": 0,
          "explanation": "500/(1 + 9) = 50.",
          "terms": [
            "math-ai-2.7-logistic-model"
          ]
        },
        {
          "id": "math-ai-2.7-2-q02",
          "type": "fill",
          "text": "The horizontal asymptote L of a logistic model is called the carrying ___.",
          "answer": "capacity",
          "bank": [
            "rate",
            "capacity",
            "constant",
            "value"
          ],
          "explanation": "It is the long-term limit of the population.",
          "terms": [
            "math-ai-2.7-carrying-capacity"
          ]
        },
        {
          "id": "math-ai-2.7-2-q03",
          "type": "tf",
          "statement": "If y = ke^(ax), a graph of ln y against x is a straight line.",
          "answer": true,
          "explanation": "ln y = ln k + ax: gradient a, intercept ln k.",
          "terms": [
            "math-ai-2.7-semi-log-graph",
            "math-ai-2.7-linearisation"
          ]
        },
        {
          "id": "math-ai-2.7-2-q04",
          "type": "mcq",
          "prompt": "For y = kxⁿ, a graph of log y against log x is a straight line with gradient:",
          "options": [
            "k",
            "n",
            "log k",
            "log n"
          ],
          "answer": 1,
          "explanation": "log y = log k + n log x.",
          "terms": [
            "math-ai-2.7-log-log-graph"
          ]
        },
        {
          "id": "math-ai-2.7-2-q05",
          "type": "mcq",
          "prompt": "A log-log graph (base 10) gives log y = 0.5 + 2 log x. Find the model.",
          "options": [
            "y = 3.16x²",
            "y = 0.5x²",
            "y = 2x^0.5",
            "y = 3.16x^0.5"
          ],
          "answer": 0,
          "explanation": "k = 10^0.5 ≈ 3.16 and n = 2.",
          "terms": [
            "math-ai-2.7-log-log-graph"
          ]
        },
        {
          "id": "math-ai-2.7-2-q06",
          "type": "tf",
          "statement": "A model y = a + b ln x with b > 0 increases without limit, but more and more slowly.",
          "answer": true,
          "explanation": "ln x is unbounded but its gradient b/x tends to 0.",
          "terms": [
            "math-ai-2.7-natural-log-model"
          ]
        },
        {
          "id": "math-ai-2.7-2-q07",
          "type": "mcq",
          "prompt": "A semi-log graph gives ln y = 1.2 + 0.3x. Find the model.",
          "options": [
            "y = 1.2e^(0.3x)",
            "y = 0.3e^(1.2x)",
            "y = 3.32e^(0.3x)",
            "y = 3.32x^0.3"
          ],
          "answer": 2,
          "explanation": "y = e^1.2 × e^(0.3x) and e^1.2 ≈ 3.32.",
          "terms": [
            "math-ai-2.7-semi-log-graph"
          ]
        },
        {
          "id": "math-ai-2.7-2-q08",
          "type": "match",
          "prompt": "Match each model to the graph on which it appears as a straight line.",
          "pairs": [
            {
              "left": "y = kaˣ",
              "right": "log y against x"
            },
            {
              "left": "y = kxⁿ",
              "right": "log y against log x"
            },
            {
              "left": "y = a + b ln x",
              "right": "y against ln x"
            },
            {
              "left": "y = mx + c",
              "right": "y against x"
            }
          ],
          "explanation": "Choose the axes that turn the model into a linear equation.",
          "terms": [
            "math-ai-2.7-linearisation",
            "math-ai-2.7-semi-log-graph",
            "math-ai-2.7-log-log-graph"
          ]
        },
        {
          "id": "math-ai-2.7-2-q09",
          "type": "fill",
          "text": "In f(x) = a sin(b(x − c)) + d, c gives a horizontal ___.",
          "answer": "translation",
          "bank": [
            "stretch",
            "reflection",
            "translation",
            "asymptote"
          ],
          "explanation": "c is the phase shift: the graph moves c units right.",
          "terms": [
            "math-ai-2.7-translation"
          ]
        },
        {
          "id": "math-ai-2.7-2-q10",
          "type": "order",
          "prompt": "Put the steps for fitting a power model by linearisation in order.",
          "items": [
            "Suspect a power model y = kxⁿ",
            "Calculate log x and log y for each data point",
            "Fit a linear regression to (log x, log y)",
            "Convert the gradient and intercept back to n and k"
          ],
          "explanation": "The gradient gives n and 10^(intercept) gives k.",
          "terms": [
            "math-ai-2.7-linearisation",
            "math-ai-2.7-log-log-graph"
          ]
        }
      ]
    }
  ]
}
