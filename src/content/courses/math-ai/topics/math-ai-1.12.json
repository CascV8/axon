{
  "id": "math-ai-1.12",
  "code": "AHL 1.12–1.13",
  "unit": "1",
  "title": "Complex numbers",
  "level": "HL",
  "summary": "Complex numbers in Cartesian, polar and exponential (Euler) form, their geometry on an Argand diagram and an application to adding alternating currents or voltages.",
  "keyterms": [
    {
      "id": "math-ai-1.12-imaginary-unit",
      "term": "Imaginary unit",
      "definition": "i, defined by i² = −1.",
      "hl": true
    },
    {
      "id": "math-ai-1.12-complex-number",
      "term": "Complex number",
      "definition": "A number z = a + bi with a, b real; the Cartesian form.",
      "hl": true
    },
    {
      "id": "math-ai-1.12-real-part",
      "term": "Real part",
      "definition": "Re(z) = a for z = a + bi.",
      "hl": true
    },
    {
      "id": "math-ai-1.12-imaginary-part",
      "term": "Imaginary part",
      "definition": "Im(z) = b for z = a + bi (a real number).",
      "hl": true
    },
    {
      "id": "math-ai-1.12-conjugate",
      "term": "Complex conjugate",
      "definition": "z* = a − bi for z = a + bi; z·z* = a² + b² is real.",
      "hl": true
    },
    {
      "id": "math-ai-1.12-argand-diagram",
      "term": "Argand diagram",
      "definition": "A plane with real part on the horizontal axis and imaginary part on the vertical axis.",
      "hl": true
    },
    {
      "id": "math-ai-1.12-modulus",
      "term": "Modulus",
      "definition": "|z| = √(a² + b²), the distance of z from the origin on an Argand diagram.",
      "hl": true
    },
    {
      "id": "math-ai-1.12-argument",
      "term": "Argument",
      "definition": "arg z = θ, the angle from the positive real axis to z, usually in radians.",
      "hl": true
    },
    {
      "id": "math-ai-1.12-polar-form",
      "term": "Polar form",
      "definition": "z = r(cos θ + i sin θ) = r cis θ, with r = |z| and θ = arg z.",
      "hl": true
    },
    {
      "id": "math-ai-1.12-euler-form",
      "term": "Exponential (Euler) form",
      "definition": "z = re^(iθ), equivalent to r cis θ.",
      "hl": true
    },
    {
      "id": "math-ai-1.12-phasor",
      "term": "Phasor",
      "definition": "A complex number representing a sinusoid’s amplitude (modulus) and phase (argument), used for AC circuits.",
      "hl": true
    }
  ],
  "lessons": [
    {
