{
  "id": "math-ai-5.9",
  "code": "AHL 5.9–5.18",
  "unit": "5",
  "title": "Further calculus and differential equations",
  "level": "HL",
  "summary": "Derivatives of trigonometric, exponential and log functions with the chain, product and quotient rules, second derivatives, volumes of revolution, kinematics, and differential equations solved exactly, with slope fields and with Euler’s method.",
  "keyterms": [
    {
      "id": "math-ai-5.9-chain-rule",
      "term": "Chain rule",
      "definition": "dy/dx = dy/du × du/dx for composite functions.",
      "hl": true
    },
    {
      "id": "math-ai-5.9-product-rule",
      "term": "Product rule",
      "definition": "d/dx(uv) = u dv/dx + v du/dx.",
      "hl": true
    },
    {
      "id": "math-ai-5.9-quotient-rule",
      "term": "Quotient rule",
      "definition": "d/dx(u/v) = (v du/dx − u dv/dx)/v².",
      "hl": true
    },
    {
      "id": "math-ai-5.9-related-rates",
      "term": "Related rates",
      "definition": "Linking rates of change with the chain rule, e.g. dA/dt = dA/dr × dr/dt.",
      "hl": true
    },
    {
      "id": "math-ai-5.9-second-derivative",
      "term": "Second derivative",
      "definition": "f″(x): f″ > 0 means concave up, f″ < 0 concave down.",
      "hl": true
    },
    {
      "id": "math-ai-5.9-point-of-inflection",
      "term": "Point of inflection",
      "definition": "A point where f″(x) = 0 and changes sign, so the concavity changes.",
      "hl": true
    },
    {
      "id": "math-ai-5.9-volume-of-revolution",
      "term": "Volume of revolution",
      "definition": "V = ∫ₐᵇ πy² dx about the x-axis (or ∫ πx² dy about the y-axis).",
      "hl": true
    },
    {
      "id": "math-ai-5.9-kinematics",
      "term": "Kinematics",
      "definition": "Displacement s, velocity v = ds/dt and acceleration a = dv/dt; distance = ∫|v| dt.",
      "hl": true
    },
    {
      "id": "math-ai-5.9-differential-equation",
      "term": "Differential equation",
      "definition": "An equation involving a derivative, e.g. dy/dx = ky.",
      "hl": true
    },
    {
      "id": "math-ai-5.9-separation-of-variables",
      "term": "Separation of variables",
      "definition": "Rewriting dy/dx = f(x)g(y) as ∫1/g(y) dy = ∫f(x) dx.",
      "hl": true
    },
    {
      "id": "math-ai-5.9-slope-field",
      "term": "Slope field",
      "definition": "A diagram of short line segments showing the gradient of a differential equation at many points.",
      "hl": true
    },
    {
      "id": "math-ai-5.9-euler-method",
      "term": "Euler’s method",
      "definition": "yₙ₊₁ = yₙ + h × f(xₙ, yₙ): a step-by-step numerical solution of dy/dx = f(x, y).",
      "hl": true
    },
    {
      "id": "math-ai-5.9-phase-portrait",
      "term": "Phase portrait",
      "definition": "A diagram of trajectories for a coupled system; its shape depends on the eigenvalues.",
      "hl": true
    }
  ],
  "lessons": [
