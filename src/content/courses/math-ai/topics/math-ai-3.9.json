{
  "id": "math-ai-3.9",
  "code": "AHL 3.9–3.13",
  "unit": "3",
  "title": "Vectors and matrix transformations",
  "level": "HL",
  "summary": "Vectors in 2D and 3D, equations of lines, kinematics with vectors, scalar and vector products, and matrices as geometric transformations.",
  "keyterms": [
    {
      "id": "math-ai-3.9-vector",
      "term": "Vector",
      "definition": "A quantity with magnitude and direction, written as a column or as xi + yj + zk.",
      "hl": true
    },
    {
      "id": "math-ai-3.9-magnitude",
      "term": "Magnitude",
      "definition": "|v| = √(x² + y² + z²), the length of a vector.",
      "hl": true
    },
    {
      "id": "math-ai-3.9-unit-vector",
      "term": "Unit vector",
      "definition": "A vector of magnitude 1: v/|v|.",
      "hl": true
    },
    {
      "id": "math-ai-3.9-direction-vector",
      "term": "Direction vector",
      "definition": "b in r = a + λb, giving the direction of a line.",
      "hl": true
    },
    {
      "id": "math-ai-3.9-vector-equation-line",
      "term": "Vector equation of a line",
      "definition": "r = a + λb, where a is a position vector of a point on the line.",
      "hl": true
    },
    {
      "id": "math-ai-3.9-velocity-vector",
      "term": "Velocity vector",
      "definition": "In r = r₀ + tv, v gives the velocity; its magnitude is the speed.",
      "hl": true
    },
    {
      "id": "math-ai-3.9-scalar-product",
      "term": "Scalar product",
      "definition": "v·w = v₁w₁ + v₂w₂ + v₃w₃ = |v||w| cos θ; zero for perpendicular vectors.",
      "hl": true
    },
    {
      "id": "math-ai-3.9-vector-product",
      "term": "Vector product",
      "definition": "v × w, perpendicular to both; |v × w| = |v||w| sin θ is the parallelogram area.",
      "hl": true
    },
    {
      "id": "math-ai-3.9-transformation-matrix",
      "term": "Transformation matrix",
      "definition": "A 2 × 2 matrix that maps each point (as a column vector) to its image.",
      "hl": true
    },
    {
      "id": "math-ai-3.9-area-scale-factor",
      "term": "Area scale factor",
      "definition": "|det T|: image area = |det T| × object area.",
      "hl": true
    },
    {
      "id": "math-ai-3.9-composite-transformation",
      "term": "Composite transformation",
      "definition": "Doing A then B is represented by the matrix BA.",
      "hl": true
    }
  ],
  "lessons": [
