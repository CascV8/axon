{
  "id": "math-ai-1.2",
  "code": "SL 1.2–1.3, AHL 1.11",
  "unit": "1",
  "title": "Arithmetic and geometric sequences",
  "level": "SL",
  "summary": "Sequences that grow by adding (arithmetic) or multiplying (geometric), their sums, and real applications such as simple interest and population growth. HL adds sums to infinity.",
  "keyterms": [
    {
      "id": "math-ai-1.2-sequence",
      "term": "Sequence",
      "definition": "An ordered list of numbers (terms) u₁, u₂, u₃, …",
      "hl": false
    },
    {
      "id": "math-ai-1.2-arithmetic-sequence",
      "term": "Arithmetic sequence",
      "definition": "A sequence with a constant difference between consecutive terms: uₙ = u₁ + (n − 1)d.",
      "hl": false
    },
    {
      "id": "math-ai-1.2-common-difference",
      "term": "Common difference",
      "definition": "d = uₙ₊₁ − uₙ, the constant amount added each time in an arithmetic sequence.",
      "hl": false
    },
    {
      "id": "math-ai-1.2-arithmetic-series",
      "term": "Arithmetic series",
      "definition": "The sum of terms of an arithmetic sequence: Sₙ = n/2 (2u₁ + (n − 1)d) = n/2 (u₁ + uₙ).",
      "hl": false
    },
    {
      "id": "math-ai-1.2-geometric-sequence",
      "term": "Geometric sequence",
      "definition": "A sequence where each term is the previous one multiplied by a constant: uₙ = u₁rⁿ⁻¹.",
      "hl": false
    },
    {
      "id": "math-ai-1.2-common-ratio",
      "term": "Common ratio",
      "definition": "r = uₙ₊₁ / uₙ, the constant multiplier in a geometric sequence.",
      "hl": false
    },
    {
      "id": "math-ai-1.2-geometric-series",
      "term": "Geometric series",
      "definition": "The sum of terms of a geometric sequence: Sₙ = u₁(rⁿ − 1)/(r − 1), r ≠ 1.",
      "hl": false
    },
    {
      "id": "math-ai-1.2-sigma-notation",
      "term": "Sigma notation",
      "definition": "Σ is used to write a sum compactly, e.g. Σ from k = 1 to n of uₖ.",
      "hl": false
    },
    {
      "id": "math-ai-1.2-simple-interest",
      "term": "Simple interest",
      "definition": "Interest calculated only on the original amount, so the total grows arithmetically.",
      "hl": false
    },
    {
      "id": "math-ai-1.2-sum-to-infinity",
      "term": "Sum to infinity",
      "definition": "S∞ = u₁/(1 − r): the limit of the partial sums of a geometric series when |r| < 1.",
      "hl": true
    },
    {
      "id": "math-ai-1.2-convergence",
      "term": "Convergence",
      "definition": "A series converges if its partial sums approach a finite limit; a geometric series converges when |r| < 1.",
      "hl": true
    }
  ],
  "lessons": [
    {
      "id": "math-ai-1.2-1",
      "title": "Arithmetic sequences and series",
      "hl": false,
      "questions": [
        {
          "id": "math-ai-1.2-1-q01",
          "type": "mcq",
          "prompt": "An arithmetic sequence has u₁ = 7 and d = 4. Find u₁₀.",
          "options": [
            "47",
            "40",
            "43",
            "39"
          ],
          "answer": 2,
          "explanation": "u₁₀ = 7 + 9 × 4 = 43. There are 9 steps from u₁ to u₁₀, not 10.",
          "terms": [
            "math-ai-1.2-arithmetic-sequence",
            "math-ai-1.2-common-difference"
          ]
        },
        {
          "id": "math-ai-1.2-1-q02",
          "type": "fill",
          "text": "In uₙ = u₁ + (n − 1)d, d is called the common ___.",
          "answer": "difference",
          "bank": [
            "ratio",
            "difference",
            "term",
            "sum"
          ],
          "explanation": "d is added each time, so it is the common difference.",
          "terms": [
            "math-ai-1.2-common-difference"
          ]
        },
        {
          "id": "math-ai-1.2-1-q03",
          "type": "tf",
          "statement": "The sequence 5, 9, 13, 17, … has common difference 4.",
          "answer": true,
          "explanation": "Each term is 4 more than the previous one.",
          "terms": [
            "math-ai-1.2-common-difference"
          ]
        },
        {
          "id": "math-ai-1.2-1-q04",
          "type": "mcq",
          "prompt": "Find the sum of the first 20 terms of 3, 8, 13, …",
          "options": [
            "1005",
            "98",
            "2020",
            "1010"
          ],
          "answer": 3,
          "explanation": "S₂₀ = 20/2 (2 × 3 + 19 × 5) = 10 × 101 = 1010.",
          "terms": [
            "math-ai-1.2-arithmetic-series"
          ]
        },
        {
          "id": "math-ai-1.2-1-q05",
          "type": "mcq",
          "prompt": "Which term of 12, 15, 18, … is equal to 99?",
          "options": [
            "29th",
            "33rd",
            "30th",
            "31st"
          ],
          "answer": 2,
          "explanation": "12 + 3(n − 1) = 99 gives n − 1 = 29, so n = 30.",
          "terms": [
            "math-ai-1.2-arithmetic-sequence"
          ]
        },
        {
          "id": "math-ai-1.2-1-q06",
          "type": "tf",
          "statement": "The sequence 2, 4, 8, 16, … is arithmetic.",
          "answer": false,
          "explanation": "The differences are 2, 4, 8, which are not constant; it is geometric with r = 2.",
          "terms": [
            "math-ai-1.2-arithmetic-sequence",
            "math-ai-1.2-geometric-sequence"
          ]
        },
        {
          "id": "math-ai-1.2-1-q07",
          "type": "match",
          "prompt": "Match the notation to its meaning.",
          "pairs": [
            {
              "left": "u₁",
              "right": "first term"
            },
            {
              "left": "d",
              "right": "common difference"
            },
            {
              "left": "Sₙ",
              "right": "sum of the first n terms"
            },
            {
              "left": "uₙ",
              "right": "the nth term"
            }
          ],
          "explanation": "These symbols appear in the formula booklet for sequences and series.",
          "terms": [
            "math-ai-1.2-sequence",
            "math-ai-1.2-arithmetic-series"
          ]
        },
        {
          "id": "math-ai-1.2-1-q08",
          "type": "mcq",
          "prompt": "$2000 is invested at 3% simple interest per year. What is it worth after 5 years?",
          "options": [
            "$2318.55",
            "$2060",
            "$2030",
            "$2300"
          ],
          "answer": 3,
          "explanation": "Simple interest adds 3% of $2000 = $60 each year: 2000 + 5 × 60 = 2300. $2318.55 is the compound value.",
          "terms": [
            "math-ai-1.2-simple-interest",
            "math-ai-1.2-arithmetic-sequence"
          ]
        },
        {
          "id": "math-ai-1.2-1-q09",
          "type": "fill",
          "text": "Σ (2k + 1) for k = 1 to 4 equals ___.",
          "answer": "24",
          "bank": [
            "20",
            "25",
            "24",
            "16"
          ],
          "explanation": "The terms are 3 + 5 + 7 + 9 = 24.",
          "terms": [
            "math-ai-1.2-sigma-notation"
          ]
        },
        {
          "id": "math-ai-1.2-1-q10",
          "type": "order",
          "prompt": "Put the steps for finding an arithmetic series sum in order.",
          "items": [
            "Identify u₁, d and n",
            "Substitute into Sₙ = n/2 (2u₁ + (n − 1)d)",
            "Evaluate the bracket",
            "Multiply by n/2"
          ],
          "explanation": "Identify the parameters first; then the formula does the rest.",
          "terms": [
            "math-ai-1.2-arithmetic-series"
          ]
        }
      ]
    },
    {
      "id": "math-ai-1.2-2",
      "title": "Geometric sequences and series",
      "hl": false,
      "questions": [
        {
          "id": "math-ai-1.2-2-q01",
          "type": "mcq",
          "prompt": "Find u₆ for the geometric sequence 5, 15, 45, …",
          "options": [
            "3645",
            "1215",
            "405",
            "90"
          ],
          "answer": 1,
          "explanation": "u₆ = 5 × 3⁵ = 1215. The power is n − 1 = 5.",
          "terms": [
            "math-ai-1.2-geometric-sequence",
            "math-ai-1.2-common-ratio"
          ]
        },
        {
          "id": "math-ai-1.2-2-q02",
          "type": "fill",
          "text": "In a geometric sequence each term is the previous term multiplied by the common ___.",
          "answer": "ratio",
          "bank": [
            "difference",
            "sum",
            "ratio",
            "term"
          ],
          "explanation": "The constant multiplier r is the common ratio.",
          "terms": [
            "math-ai-1.2-common-ratio"
          ]
        },
        {
          "id": "math-ai-1.2-2-q03",
          "type": "tf",
          "statement": "A geometric sequence with a positive first term and r = 0.5 has terms that decrease towards 0.",
          "answer": true,
          "explanation": "Each term is half the previous one, so terms shrink towards 0 but never reach it.",
          "terms": [
            "math-ai-1.2-geometric-sequence"
          ]
        },
        {
          "id": "math-ai-1.2-2-q04",
          "type": "mcq",
          "prompt": "Find the sum of the first 8 terms of a geometric series with u₁ = 3 and r = 2.",
          "options": [
            "768",
            "381",
            "765",
            "1533"
          ],
          "answer": 2,
          "explanation": "S₈ = 3(2⁸ − 1)/(2 − 1) = 3 × 255 = 765.",
          "terms": [
            "math-ai-1.2-geometric-series"
          ]
        },
        {
          "id": "math-ai-1.2-2-q05",
          "type": "mcq",
          "prompt": "A town of 1200 people grows by 4% per year. Find its population after 5 complete years.",
          "options": [
            "1404",
            "1460",
            "1440",
            "1518"
          ],
          "answer": 1,
          "explanation": "1200 × 1.04⁵ ≈ 1460. After 5 years is u₆ if u₁ is the starting population.",
          "terms": [
            "math-ai-1.2-geometric-sequence",
            "math-ai-1.2-common-ratio"
          ]
        },
        {
          "id": "math-ai-1.2-2-q06",
          "type": "tf",
          "statement": "The sequence 2, −6, 18, −54, … has common ratio −3.",
          "answer": true,
          "explanation": "−6 ÷ 2 = −3; a negative ratio makes the signs alternate.",
          "terms": [
            "math-ai-1.2-common-ratio"
          ]
        },
        {
          "id": "math-ai-1.2-2-q07",
          "type": "mcq",
          "prompt": "Find the smallest n for which uₙ = 2 × 3ⁿ⁻¹ exceeds 10 000.",
          "options": [
            "8",
            "10",
            "7",
            "9"
          ],
          "answer": 3,
          "explanation": "u₈ = 2 × 3⁷ = 4374 and u₉ = 2 × 3⁸ = 13 122, so n = 9. A GDC table finds this quickly.",
          "terms": [
            "math-ai-1.2-geometric-sequence"
          ]
        },
        {
          "id": "math-ai-1.2-2-q08",
          "type": "match",
          "prompt": "Classify each sequence.",
          "pairs": [
            {
              "left": "4, 7, 10, 13",
              "right": "arithmetic, d = 3"
            },
            {
              "left": "4, 8, 16, 32",
              "right": "geometric, r = 2"
            },
            {
              "left": "32, 16, 8, 4",
              "right": "geometric, r = 0.5"
            },
            {
              "left": "13, 10, 7, 4",
              "right": "arithmetic, d = −3"
            }
          ],
          "explanation": "Check for a constant difference or a constant ratio.",
          "terms": [
            "math-ai-1.2-arithmetic-sequence",
            "math-ai-1.2-geometric-sequence"
          ]
        },
        {
          "id": "math-ai-1.2-2-q09",
          "type": "fill",
          "text": "The common ratio of 50, 40, 32, … is ___.",
          "answer": "0.8",
          "bank": [
            "−10",
            "1.25",
            "0.2",
            "0.8"
          ],
          "explanation": "r = 40 ÷ 50 = 0.8; a ratio below 1 shows a 20% decrease each time.",
          "terms": [
            "math-ai-1.2-common-ratio"
          ]
        },
        {
          "id": "math-ai-1.2-2-q10",
          "type": "tf",
          "statement": "The formula Sₙ = u₁(rⁿ − 1)/(r − 1) can be used when r = 1.",
          "answer": false,
          "explanation": "r = 1 makes the denominator zero; when r = 1 every term is u₁, so Sₙ = nu₁.",
          "terms": [
            "math-ai-1.2-geometric-series"
          ]
        }
      ]
    },
    {
      "id": "math-ai-1.2-3",
      "title": "Sums to infinity",
      "hl": true,
      "questions": [
        {
          "id": "math-ai-1.2-3-q01",
          "type": "mcq",
          "prompt": "A geometric series has a sum to infinity when:",
          "options": [
            "|r| < 1",
            "r > 1",
            "r ≠ 1",
            "|r| > 1"
          ],
          "answer": 0,
          "explanation": "Only when |r| < 1 do the terms shrink fast enough for the partial sums to approach a limit.",
          "terms": [
            "math-ai-1.2-sum-to-infinity",
            "math-ai-1.2-convergence"
          ]
        },
        {
          "id": "math-ai-1.2-3-q02",
          "type": "fill",
          "text": "S∞ = u₁ / (1 − ___)",
          "answer": "r",
          "bank": [
            "d",
            "n",
            "u₁",
            "r"
          ],
          "explanation": "The sum to infinity depends only on the first term and the common ratio.",
          "terms": [
            "math-ai-1.2-sum-to-infinity"
          ]
        },
        {
          "id": "math-ai-1.2-3-q03",
          "type": "mcq",
          "prompt": "Find the sum to infinity of 18 + 6 + 2 + …",
          "options": [
            "54",
            "24",
            "27",
            "26"
          ],
          "answer": 2,
          "explanation": "r = 1/3, so S∞ = 18 / (1 − 1/3) = 27.",
          "terms": [
            "math-ai-1.2-sum-to-infinity"
          ]
        },
        {
          "id": "math-ai-1.2-3-q04",
          "type": "tf",
          "statement": "The series 1 + 1.1 + 1.21 + … has a finite sum to infinity.",
          "answer": false,
          "explanation": "r = 1.1 > 1, so the terms grow and the series diverges.",
          "terms": [
            "math-ai-1.2-convergence"
          ]
        },
        {
          "id": "math-ai-1.2-3-q05",
          "type": "mcq",
          "prompt": "A geometric series has S∞ = 40 and r = 0.75. Find u₁.",
          "options": [
            "10",
            "30",
            "160",
            "53.3"
          ],
          "answer": 0,
          "explanation": "u₁ = S∞(1 − r) = 40 × 0.25 = 10.",
          "terms": [
            "math-ai-1.2-sum-to-infinity"
          ]
        },
        {
          "id": "math-ai-1.2-3-q06",
          "type": "tf",
          "statement": "A geometric series with r = −0.5 converges.",
          "answer": true,
          "explanation": "|−0.5| < 1, so it converges even though the terms alternate in sign.",
          "terms": [
            "math-ai-1.2-convergence"
          ]
        },
        {
          "id": "math-ai-1.2-3-q07",
          "type": "mcq",
          "prompt": "A ball is dropped from 10 m and each bounce reaches 60% of the previous height. Find the total vertical distance travelled.",
          "options": [
            "25 m",
            "30 m",
            "40 m",
            "50 m"
          ],
          "answer": 2,
          "explanation": "Down 10 m, then up and down each rebound: 10 + 2 × 6/(1 − 0.6) = 10 + 30 = 40 m.",
          "terms": [
            "math-ai-1.2-sum-to-infinity"
          ]
        },
        {
          "id": "math-ai-1.2-3-q08",
          "type": "match",
          "prompt": "Match each series to its sum to infinity.",
          "pairs": [
            {
              "left": "8 + 4 + 2 + …",
              "right": "16"
            },
            {
              "left": "9 − 3 + 1 − …",
              "right": "6.75"
            },
            {
              "left": "5 + 1 + 0.2 + …",
              "right": "6.25"
            },
            {
              "left": "2 + 2.5 + 3.125 + …",
              "right": "does not exist"
            }
          ],
          "explanation": "Use S∞ = u₁/(1 − r): r = 0.5, −1/3 and 0.2 converge; r = 1.25 does not.",
          "terms": [
            "math-ai-1.2-sum-to-infinity",
            "math-ai-1.2-convergence"
          ]
        },
        {
          "id": "math-ai-1.2-3-q09",
          "type": "fill",
          "text": "A series whose partial sums approach a finite limit is said to ___.",
          "answer": "converge",
          "bank": [
            "converge",
            "diverge",
            "oscillate",
            "terminate"
          ],
          "explanation": "Convergent series have a finite sum to infinity.",
          "terms": [
            "math-ai-1.2-convergence"
          ]
        },
        {
          "id": "math-ai-1.2-3-q10",
          "type": "order",
          "prompt": "Order these geometric series by sum to infinity, smallest first.",
          "items": [
            "u₁ = 3, r = 0.5",
            "u₁ = 4, r = 0.5",
            "u₁ = 2, r = 0.8",
            "u₁ = 6, r = 0.5"
          ],
          "explanation": "The sums are 6, 8, 10 and 12.",
          "terms": [
            "math-ai-1.2-sum-to-infinity"
          ]
        }
      ]
    }
  ]
}
