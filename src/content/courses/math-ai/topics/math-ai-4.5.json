{
  "id": "math-ai-4.5",
  "code": "SL 4.5–4.9",
  "unit": "4",
  "title": "Probability and probability distributions",
  "level": "SL",
  "summary": "Venn and tree diagrams, conditional probability and independence, discrete random variables, the binomial distribution and the normal distribution.",
  "keyterms": [
    {
      "id": "math-ai-4.5-probability",
      "term": "Probability",
      "definition": "P(A) = n(A)/n(U) for equally likely outcomes; a number from 0 to 1.",
      "hl": false
    },
    {
      "id": "math-ai-4.5-complement",
      "term": "Complementary event",
      "definition": "A′, “not A”: P(A′) = 1 − P(A).",
      "hl": false
    },
    {
      "id": "math-ai-4.5-mutually-exclusive",
      "term": "Mutually exclusive",
      "definition": "Events that cannot happen together: P(A ∩ B) = 0.",
      "hl": false
    },
    {
      "id": "math-ai-4.5-independent",
      "term": "Independent events",
      "definition": "Events where one does not affect the other: P(A ∩ B) = P(A)P(B).",
      "hl": false
    },
    {
      "id": "math-ai-4.5-conditional",
      "term": "Conditional probability",
      "definition": "P(A | B) = P(A ∩ B)/P(B), the probability of A given that B has occurred.",
      "hl": false
    },
    {
      "id": "math-ai-4.5-expected-value",
      "term": "Expected value",
      "definition": "E(X) = Σ x P(X = x), the long-run mean of a random variable.",
      "hl": false
    },
    {
      "id": "math-ai-4.5-discrete-random-variable",
      "term": "Discrete random variable",
      "definition": "A variable with countable outcomes whose probabilities sum to 1.",
      "hl": false
    },
    {
      "id": "math-ai-4.5-binomial",
      "term": "Binomial distribution",
      "definition": "X ~ B(n, p): number of successes in n independent trials with constant probability p.",
      "hl": false
    },
    {
      "id": "math-ai-4.5-normal",
      "term": "Normal distribution",
      "definition": "X ~ N(μ, σ²): a symmetric, bell-shaped continuous distribution.",
      "hl": false
    },
    {
      "id": "math-ai-4.5-inverse-normal",
      "term": "Inverse normal",
      "definition": "Finding the value of X that gives a stated probability, using the GDC.",
      "hl": false
    },
    {
      "id": "math-ai-4.5-tree-diagram",
      "term": "Tree diagram",
      "definition": "A diagram of successive events; multiply along branches and add the outcomes required.",
      "hl": false
    }
  ],
  "lessons": [
    {
      "id": "math-ai-4.5-1",
      "title": "Probability, Venn and tree diagrams",
      "hl": false,
      "questions": [
        {
          "id": "math-ai-4.5-1-q01",
          "type": "mcq",
          "prompt": "P(A) = 0.3. Find P(A′).",
          "options": [
            "0.3",
            "0.09",
            "1.3",
            "0.7"
          ],
          "answer": 3,
          "explanation": "P(A′) = 1 − 0.3.",
          "terms": [
            "math-ai-4.5-complement"
          ]
        },
        {
          "id": "math-ai-4.5-1-q02",
          "type": "fill",
          "text": "P(A) = 0.5, P(B) = 0.4 and P(A ∩ B) = 0.2, so P(A ∪ B) = ___.",
          "answer": "0.7",
          "bank": [
            "0.9",
            "0.2",
            "0.7",
            "1.1"
          ],
          "explanation": "P(A ∪ B) = 0.5 + 0.4 − 0.2; subtract the overlap so it is not counted twice.",
          "terms": [
            "math-ai-4.5-probability"
          ]
        },
        {
          "id": "math-ai-4.5-1-q03",
          "type": "tf",
          "statement": "If A and B are mutually exclusive, then P(A ∩ B) = 0.",
          "answer": true,
          "explanation": "They cannot both happen.",
          "terms": [
            "math-ai-4.5-mutually-exclusive"
          ]
        },
        {
          "id": "math-ai-4.5-1-q04",
          "type": "mcq",
          "prompt": "A and B are independent with P(A) = 0.6 and P(B) = 0.5. Find P(A ∩ B).",
          "options": [
            "0.3",
            "1.1",
            "0.8",
            "0.1"
          ],
          "answer": 0,
          "explanation": "For independent events multiply: 0.6 × 0.5.",
          "terms": [
            "math-ai-4.5-independent"
          ]
        },
        {
          "id": "math-ai-4.5-1-q05",
          "type": "mcq",
          "prompt": "P(A ∩ B) = 0.2 and P(B) = 0.4. Find P(A | B).",
          "options": [
            "0.08",
            "0.2",
            "0.6",
            "0.5"
          ],
          "answer": 3,
          "explanation": "P(A | B) = 0.2/0.4 = 0.5.",
          "terms": [
            "math-ai-4.5-conditional"
          ]
        },
        {
          "id": "math-ai-4.5-1-q06",
          "type": "tf",
          "statement": "If A and B are independent, then P(A | B) = P(A).",
          "answer": true,
          "explanation": "Knowing B happened does not change the probability of A.",
          "terms": [
            "math-ai-4.5-independent",
            "math-ai-4.5-conditional"
          ]
        },
        {
          "id": "math-ai-4.5-1-q07",
          "type": "mcq",
          "prompt": "An item is faulty with probability 0.04. How many faulty items are expected in 500?",
          "options": [
            "4",
            "20",
            "12.5",
            "40"
          ],
          "answer": 1,
          "explanation": "Expected number = np = 500 × 0.04.",
          "terms": [
            "math-ai-4.5-expected-value"
          ]
        },
        {
          "id": "math-ai-4.5-1-q08",
          "type": "match",
          "prompt": "Match each set to its meaning.",
          "pairs": [
            {
              "left": "A ∩ B",
              "right": "in both A and B"
            },
            {
              "left": "A ∪ B",
              "right": "in A or B or both"
            },
            {
              "left": "A′",
              "right": "not in A"
            },
            {
              "left": "A ∩ B′",
              "right": "in A but not in B"
            }
          ],
          "explanation": "Shade each region on a Venn diagram to check.",
          "terms": [
            "math-ai-4.5-probability",
            "math-ai-4.5-complement"
          ]
        },
        {
          "id": "math-ai-4.5-1-q09",
          "type": "mcq",
          "prompt": "A bag has 3 red and 2 blue counters. Two are drawn without replacement. Find P(both red).",
          "options": [
            "9/25",
            "6/25",
            "1/2",
            "3/10"
          ],
          "answer": 3,
          "explanation": "3/5 × 2/4 = 6/20 = 3/10. Without replacement, the second probability changes.",
          "terms": [
            "math-ai-4.5-tree-diagram",
            "math-ai-4.5-conditional"
          ]
        },
        {
          "id": "math-ai-4.5-1-q10",
          "type": "order",
          "prompt": "Put the steps for using a tree diagram in order.",
          "items": [
            "Draw branches for the first event",
            "Label them with probabilities",
            "Draw second-stage branches with conditional probabilities",
            "Multiply along each path",
            "Add the probabilities of the paths required"
          ],
          "explanation": "Multiply along, add down.",
          "terms": [
            "math-ai-4.5-tree-diagram"
          ]
        }
      ]
    },
    {
      "id": "math-ai-4.5-2",
      "title": "Discrete and binomial distributions",
      "hl": false,
      "questions": [
        {
          "id": "math-ai-4.5-2-q01",
          "type": "mcq",
          "prompt": "P(X = 1) = 0.2, P(X = 2) = k and P(X = 3) = 0.5. Find k.",
          "options": [
            "0.5",
            "0.7",
            "0.3",
            "0.2"
          ],
          "answer": 2,
          "explanation": "Probabilities sum to 1: 0.2 + k + 0.5 = 1.",
          "terms": [
            "math-ai-4.5-discrete-random-variable"
          ]
        },
        {
          "id": "math-ai-4.5-2-q02",
          "type": "mcq",
          "prompt": "X takes 0, 1, 2 with probabilities 0.5, 0.3, 0.2. Find E(X).",
          "options": [
            "1",
            "0.7",
            "0.5",
            "1.5"
          ],
          "answer": 1,
          "explanation": "0 × 0.5 + 1 × 0.3 + 2 × 0.2 = 0.7.",
          "terms": [
            "math-ai-4.5-expected-value"
          ]
        },
        {
          "id": "math-ai-4.5-2-q03",
          "type": "tf",
          "statement": "In a fair game, the expected gain of a player is 0.",
          "answer": true,
          "explanation": "Neither side wins in the long run.",
          "terms": [
            "math-ai-4.5-expected-value"
          ]
        },
        {
          "id": "math-ai-4.5-2-q04",
          "type": "fill",
          "text": "A binomial model needs a fixed number of trials, two outcomes, constant p and ___ trials.",
          "answer": "independent",
          "bank": [
            "equal",
            "independent",
            "continuous",
            "random"
          ],
          "explanation": "Each trial must not affect the others.",
          "terms": [
            "math-ai-4.5-binomial"
          ]
        },
        {
          "id": "math-ai-4.5-2-q05",
          "type": "mcq",
          "prompt": "X ~ B(10, 0.3). Find E(X).",
          "options": [
            "0.3",
            "2.1",
            "3",
            "7"
          ],
          "answer": 2,
          "explanation": "E(X) = np = 10 × 0.3.",
          "terms": [
            "math-ai-4.5-binomial",
            "math-ai-4.5-expected-value"
          ]
        },
        {
          "id": "math-ai-4.5-2-q06",
          "type": "mcq",
          "prompt": "X ~ B(10, 0.3). Find Var(X).",
          "options": [
            "3",
            "2.1",
            "0.21",
            "1.45"
          ],
          "answer": 1,
          "explanation": "Var(X) = np(1 − p) = 10 × 0.3 × 0.7.",
          "terms": [
            "math-ai-4.5-binomial"
          ]
        },
        {
          "id": "math-ai-4.5-2-q07",
          "type": "mcq",
          "prompt": "X ~ B(5, 0.4). Find P(X = 2).",
          "options": [
            "0.346",
            "0.4",
            "0.0346",
            "0.683"
          ],
          "answer": 0,
          "explanation": "binompdf: 10 × 0.4² × 0.6³ = 0.3456.",
          "terms": [
            "math-ai-4.5-binomial"
          ]
        },
        {
          "id": "math-ai-4.5-2-q08",
          "type": "mcq",
          "prompt": "X ~ B(5, 0.4). Find P(X ≤ 1).",
          "options": [
            "0.259",
            "0.0778",
            "0.663",
            "0.337"
          ],
          "answer": 3,
          "explanation": "binomcdf: 0.6⁵ + 5(0.4)(0.6⁴) = 0.337.",
          "terms": [
            "math-ai-4.5-binomial"
          ]
        },
        {
          "id": "math-ai-4.5-2-q09",
          "type": "match",
          "prompt": "Match each probability for X ~ B(n, p) to the GDC calculation.",
          "pairs": [
            {
              "left": "P(X = k)",
              "right": "binomial pdf at k"
            },
            {
              "left": "P(X ≤ k)",
              "right": "binomial cdf at k"
            },
            {
              "left": "P(X > k)",
              "right": "1 − binomial cdf at k"
            },
            {
              "left": "P(X ≥ k)",
              "right": "1 − binomial cdf at k − 1"
            }
          ],
          "explanation": "For discrete variables, “more than” and “at least” differ.",
          "terms": [
            "math-ai-4.5-binomial"
          ]
        },
        {
          "id": "math-ai-4.5-2-q10",
          "type": "tf",
          "statement": "The number of heads in 20 flips of a fair coin can be modelled by B(20, 0.5).",
          "answer": true,
          "explanation": "Fixed n, two outcomes, constant p = 0.5 and independent flips.",
          "terms": [
            "math-ai-4.5-binomial"
          ]
        }
      ]
    },
    {
      "id": "math-ai-4.5-3",
      "title": "The normal distribution",
      "hl": false,
      "questions": [
        {
          "id": "math-ai-4.5-3-q01",
          "type": "tf",
          "statement": "A normal distribution is symmetrical about its mean.",
          "answer": true,
          "explanation": "Its mean, median and mode are equal.",
          "terms": [
            "math-ai-4.5-normal"
          ]
        },
        {
          "id": "math-ai-4.5-3-q02",
          "type": "fill",
          "text": "About ___% of normally distributed data lie within one standard deviation of the mean.",
          "answer": "68",
          "bank": [
            "68",
            "95",
            "99.7",
            "50"
          ],
          "explanation": "About 68%, 95% and 99.7% lie within 1, 2 and 3 standard deviations.",
          "terms": [
            "math-ai-4.5-normal"
          ]
        },
        {
          "id": "math-ai-4.5-3-q03",
          "type": "mcq",
          "prompt": "X ~ N(170, 8²). Find P(X > 186).",
          "options": [
            "0.0455",
            "0.977",
            "0.159",
            "0.0228"
          ],
          "answer": 3,
          "explanation": "186 is 2 standard deviations above the mean; normalcdf gives 0.0228.",
          "terms": [
            "math-ai-4.5-normal"
          ]
        },
        {
          "id": "math-ai-4.5-3-q04",
          "type": "mcq",
          "prompt": "X ~ N(170, 8²). Find P(160 < X < 180).",
          "options": [
            "0.683",
            "0.894",
            "0.789",
            "0.211"
          ],
          "answer": 2,
          "explanation": "normalcdf(160, 180, 170, 8) ≈ 0.789.",
          "terms": [
            "math-ai-4.5-normal"
          ]
        },
        {
          "id": "math-ai-4.5-3-q05",
          "type": "mcq",
          "prompt": "X ~ N(170, 8²). The tallest 10% are above h. Find h.",
          "options": [
            "159.7",
            "180.3",
            "178.0",
            "183.2"
          ],
          "answer": 1,
          "explanation": "Area to the left is 0.9: invNorm(0.9, 170, 8) ≈ 180.3.",
          "terms": [
            "math-ai-4.5-inverse-normal"
          ]
        },
        {
          "id": "math-ai-4.5-3-q06",
          "type": "mcq",
          "prompt": "For a continuous normal variable X, P(X = 170) is:",
          "options": [
            "0",
            "0.5",
            "the height of the curve at 170",
            "1"
          ],
          "answer": 0,
          "explanation": "Probabilities are areas, and a single value has zero width.",
          "terms": [
            "math-ai-4.5-normal"
          ]
        },
        {
          "id": "math-ai-4.5-3-q07",
          "type": "match",
          "prompt": "For X ~ N(μ, σ²), match each item to its meaning.",
          "pairs": [
            {
              "left": "μ",
              "right": "mean, median and mode"
            },
            {
              "left": "σ",
              "right": "standard deviation"
            },
            {
              "left": "σ²",
              "right": "variance"
            },
            {
              "left": "Total area under the curve",
              "right": "1"
            }
          ],
          "explanation": "The GDC asks for σ, not σ².",
          "terms": [
            "math-ai-4.5-normal"
          ]
        },
        {
          "id": "math-ai-4.5-3-q08",
          "type": "order",
          "prompt": "Put the steps for an inverse normal problem in order.",
          "items": [
            "Sketch the curve and shade the region",
            "Work out the area to the left of the unknown value",
            "Use inverse normal with μ and σ",
            "Interpret the value in context"
          ],
          "explanation": "Most GDCs need the area to the left (some allow a tail choice).",
          "terms": [
            "math-ai-4.5-inverse-normal"
          ]
        },
        {
          "id": "math-ai-4.5-3-q09",
          "type": "mcq",
          "prompt": "Which variable is most likely to be modelled well by a normal distribution?",
          "options": [
            "Number of cars passing in a minute",
            "Heights of adult women",
            "Score on one die roll",
            "Number of heads in 3 flips"
          ],
          "answer": 1,
          "explanation": "Heights are continuous and roughly symmetric around a mean; the others are discrete.",
          "terms": [
            "math-ai-4.5-normal"
          ]
        },
        {
          "id": "math-ai-4.5-3-q10",
          "type": "mcq",
          "prompt": "X ~ N(170, 8²). How many standard deviations above the mean is 186?",
          "options": [
            "2",
            "16",
            "1.5",
            "8"
          ],
          "answer": 0,
          "explanation": "(186 − 170)/8 = 2.",
          "terms": [
            "math-ai-4.5-normal"
          ]
        }
      ]
    }
  ]
}
