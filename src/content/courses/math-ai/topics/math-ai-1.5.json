{
  "id": "math-ai-1.5",
  "code": "SL 1.5, 1.8, AHL 1.9–1.10",
  "unit": "1",
  "title": "Exponents, logarithms and solving equations",
  "level": "SL",
  "summary": "Laws of exponents, logarithms base 10 and e, and using technology to solve systems of linear equations and polynomial equations. HL adds the laws of logarithms and rational exponents.",
  "keyterms": [
    {
      "id": "math-ai-1.5-exponent",
      "term": "Exponent",
      "definition": "The power n in aⁿ, showing how many times the base is used as a factor.",
      "hl": false
    },
    {
      "id": "math-ai-1.5-logarithm",
      "term": "Logarithm",
      "definition": "logₐ b is the power to which a must be raised to give b: aˣ = b ⇔ x = logₐ b.",
      "hl": false
    },
    {
      "id": "math-ai-1.5-natural-log",
      "term": "Natural logarithm",
      "definition": "ln x, the logarithm to base e ≈ 2.718.",
      "hl": false
    },
    {
      "id": "math-ai-1.5-euler-number",
      "term": "e",
      "definition": "The irrational constant e ≈ 2.718 used in exponential growth and decay models.",
      "hl": false
    },
    {
      "id": "math-ai-1.5-polynomial-equation",
      "term": "Polynomial equation",
      "definition": "An equation such as ax³ + bx² + cx + d = 0; its roots can be found with a GDC solver.",
      "hl": false
    },
    {
      "id": "math-ai-1.5-linear-system",
      "term": "System of linear equations",
      "definition": "Two or three linear equations in two or three unknowns that must all be true at once.",
      "hl": false
    },
    {
      "id": "math-ai-1.5-root",
      "term": "Root (zero)",
      "definition": "A value of x for which p(x) = 0; an x-intercept of y = p(x).",
      "hl": false
    },
    {
      "id": "math-ai-1.5-law-of-logs",
      "term": "Laws of logarithms",
      "definition": "log xy = log x + log y, log(x/y) = log x − log y, log xⁿ = n log x.",
      "hl": true
    },
    {
      "id": "math-ai-1.5-rational-exponent",
      "term": "Rational exponent",
      "definition": "x^(m/n) = (ⁿ√x)ᵐ; a fractional power means a root.",
      "hl": true
    },
    {
      "id": "math-ai-1.5-change-of-base",
      "term": "Change of base",
      "definition": "logₐ x = log x / log a (any base), used to evaluate logs in unusual bases.",
      "hl": true
    }
  ],
  "lessons": [
    {
      "id": "math-ai-1.5-1",
      "title": "Exponents and logarithms",
      "hl": false,
      "questions": [
        {
          "id": "math-ai-1.5-1-q01",
          "type": "mcq",
          "prompt": "Simplify (2x³)² × x⁻⁴.",
          "options": [
            "4x²",
            "2x²",
            "4x⁵",
            "4x¹⁰"
          ],
          "answer": 0,
          "explanation": "(2x³)² = 4x⁶, and 4x⁶ × x⁻⁴ = 4x².",
          "terms": [
            "math-ai-1.5-exponent"
          ]
        },
        {
          "id": "math-ai-1.5-1-q02",
          "type": "fill",
          "text": "log₁₀ 1000 = ___",
          "answer": "3",
          "bank": [
            "100",
            "10",
            "30",
            "3"
          ],
          "explanation": "10³ = 1000, so the logarithm is 3.",
          "terms": [
            "math-ai-1.5-logarithm"
          ]
        },
        {
          "id": "math-ai-1.5-1-q03",
          "type": "tf",
          "statement": "aˣ = b is equivalent to x = logₐ b.",
          "answer": true,
          "explanation": "A logarithm answers “what power?”.",
          "terms": [
            "math-ai-1.5-logarithm"
          ]
        },
        {
          "id": "math-ai-1.5-1-q04",
          "type": "mcq",
          "prompt": "Solve 10ˣ = 450, giving x to 3 s.f.",
          "options": [
            "6.11",
            "2.65",
            "45.0",
            "2.03"
          ],
          "answer": 1,
          "explanation": "x = log₁₀ 450 ≈ 2.65. 6.11 is ln 450, the wrong base.",
          "terms": [
            "math-ai-1.5-logarithm"
          ]
        },
        {
          "id": "math-ai-1.5-1-q05",
          "type": "mcq",
          "prompt": "Evaluate ln(e⁵).",
          "options": [
            "5",
            "e⁵",
            "1",
            "0.5"
          ],
          "answer": 0,
          "explanation": "ln and eˣ are inverse functions, so ln(e⁵) = 5.",
          "terms": [
            "math-ai-1.5-natural-log",
            "math-ai-1.5-euler-number"
          ]
        },
        {
          "id": "math-ai-1.5-1-q06",
          "type": "tf",
          "statement": "x⁰ = 0 for every non-zero x.",
          "answer": false,
          "explanation": "Any non-zero number to the power 0 equals 1.",
          "terms": [
            "math-ai-1.5-exponent"
          ]
        },
        {
          "id": "math-ai-1.5-1-q07",
          "type": "match",
          "prompt": "Match each expression to its value.",
          "pairs": [
            {
              "left": "log₁₀ 0.01",
              "right": "−2"
            },
            {
              "left": "ln 1",
              "right": "0"
            },
            {
              "left": "log₂ 32",
              "right": "5"
            },
            {
              "left": "10^(log₁₀ 7)",
              "right": "7"
            }
          ],
          "explanation": "10⁻² = 0.01, e⁰ = 1, 2⁵ = 32, and 10ˣ undoes log₁₀.",
          "terms": [
            "math-ai-1.5-logarithm",
            "math-ai-1.5-natural-log"
          ]
        },
        {
          "id": "math-ai-1.5-1-q08",
          "type": "fill",
          "text": "The natural logarithm ln x is the logarithm to base ___.",
          "answer": "e",
          "bank": [
            "10",
            "e",
            "2",
            "π"
          ],
          "explanation": "ln means logₑ.",
          "terms": [
            "math-ai-1.5-natural-log",
            "math-ai-1.5-euler-number"
          ]
        },
        {
          "id": "math-ai-1.5-1-q09",
          "type": "mcq",
          "prompt": "Evaluate 3⁻².",
          "options": [
            "1/9",
            "−9",
            "−6",
            "1/6"
          ],
          "answer": 0,
          "explanation": "A negative exponent means a reciprocal: 3⁻² = 1/3² = 1/9.",
          "terms": [
            "math-ai-1.5-exponent"
          ]
        },
        {
          "id": "math-ai-1.5-1-q10",
          "type": "order",
          "prompt": "Put these in order from smallest to largest.",
          "items": [
            "log₁₀ 0.5",
            "ln 1",
            "log₁₀ 50",
            "ln 10"
          ],
          "explanation": "The values are about −0.301, 0, 1.70 and 2.30.",
          "terms": [
            "math-ai-1.5-logarithm",
            "math-ai-1.5-natural-log"
          ]
        }
      ]
    },
    {
      "id": "math-ai-1.5-2",
      "title": "Solving equations with technology",
      "hl": false,
      "questions": [
        {
          "id": "math-ai-1.5-2-q01",
          "type": "mcq",
          "prompt": "Solve x + y + z = 6, 2x − y + z = 3, x + 2y − z = 2.",
          "options": [
            "x = 2, y = 1, z = 3",
            "x = 3, y = 2, z = 1",
            "x = 1, y = 3, z = 2",
            "x = 1, y = 2, z = 3"
          ],
          "answer": 3,
          "explanation": "A GDC simultaneous-equation solver gives (1, 2, 3); check: 1 + 2 + 3 = 6, 2 − 2 + 3 = 3, 1 + 4 − 3 = 2.",
          "terms": [
            "math-ai-1.5-linear-system"
          ]
        },
        {
          "id": "math-ai-1.5-2-q02",
          "type": "tf",
          "statement": "A GDC polynomial solver gives the real roots of a cubic, but they should still be checked against the context.",
          "answer": true,
          "explanation": "Some roots may be negative or otherwise impossible in the real situation.",
          "terms": [
            "math-ai-1.5-polynomial-equation",
            "math-ai-1.5-root"
          ]
        },
        {
          "id": "math-ai-1.5-2-q03",
          "type": "mcq",
          "prompt": "Solve x³ − 6x² + 11x − 6 = 0.",
          "options": [
            "x = −1, −2, −3",
            "x = 1, 2, 3",
            "x = 1, 3, 6",
            "x = 2, 3 only"
          ],
          "answer": 1,
          "explanation": "Substituting confirms 1, 2 and 3 all give zero.",
          "terms": [
            "math-ai-1.5-polynomial-equation",
            "math-ai-1.5-root"
          ]
        },
        {
          "id": "math-ai-1.5-2-q04",
          "type": "fill",
          "text": "A quadratic equation has at most ___ real roots.",
          "answer": "2",
          "bank": [
            "1",
            "3",
            "2",
            "4"
          ],
          "explanation": "A polynomial of degree n has at most n real roots.",
          "terms": [
            "math-ai-1.5-root"
          ]
        },
        {
          "id": "math-ai-1.5-2-q05",
          "type": "mcq",
          "prompt": "Three adult and two child tickets cost $64; one adult and four child tickets cost $48. Find the prices.",
          "options": [
            "Adult $8, child $16",
            "Adult $12, child $14",
            "Adult $14, child $11",
            "Adult $16, child $8"
          ],
          "answer": 3,
          "explanation": "Solve 3a + 2c = 64 and a + 4c = 48 to get a = 16, c = 8; check both equations.",
          "terms": [
            "math-ai-1.5-linear-system"
          ]
        },
        {
          "id": "math-ai-1.5-2-q06",
          "type": "tf",
          "statement": "Two linear equations in two unknowns always have exactly one solution.",
          "answer": false,
          "explanation": "Parallel lines give no solution and identical lines give infinitely many.",
          "terms": [
            "math-ai-1.5-linear-system"
          ]
        },
        {
          "id": "math-ai-1.5-2-q07",
          "type": "mcq",
          "prompt": "Solve 2x² − 3x − 5 = 0.",
          "options": [
            "x = −2.5 or x = 1",
            "x = 2.5 or x = −1",
            "x = 5 or x = −1",
            "x = 1.5 or x = −5"
          ],
          "answer": 1,
          "explanation": "Factorise (2x − 5)(x + 1) = 0, or use the GDC polynomial solver.",
          "terms": [
            "math-ai-1.5-polynomial-equation",
            "math-ai-1.5-root"
          ]
        },
        {
          "id": "math-ai-1.5-2-q08",
          "type": "match",
          "prompt": "Match each situation to the number of solutions.",
          "pairs": [
            {
              "left": "Two parallel, distinct lines",
              "right": "no solution"
            },
            {
              "left": "The same line written twice",
              "right": "infinitely many solutions"
            },
            {
              "left": "Two lines that cross",
              "right": "exactly one solution"
            }
          ],
          "explanation": "Solutions of a linear system are the points where all the graphs meet.",
          "terms": [
            "math-ai-1.5-linear-system"
          ]
        },
        {
          "id": "math-ai-1.5-2-q09",
          "type": "fill",
          "text": "The real roots of p(x) = 0 are the x-intercepts of y = p(x), also called the ___ of p.",
          "answer": "zeros",
          "bank": [
            "asymptotes",
            "zeros",
            "vertices",
            "gradients"
          ],
          "explanation": "A root, zero and x-intercept describe the same value.",
          "terms": [
            "math-ai-1.5-root"
          ]
        },
        {
          "id": "math-ai-1.5-2-q10",
          "type": "order",
          "prompt": "Put the steps for solving a word problem with a linear system in order.",
          "items": [
            "Define the variables",
            "Write equations from the information",
            "Solve with the GDC",
            "Interpret the solution in context"
          ],
          "explanation": "Defining variables first makes the equations and final answer clear.",
          "terms": [
            "math-ai-1.5-linear-system"
          ]
        }
      ]
    },
    {
      "id": "math-ai-1.5-3",
      "title": "Laws of logarithms and rational exponents",
      "hl": true,
      "questions": [
        {
          "id": "math-ai-1.5-3-q01",
          "type": "mcq",
          "prompt": "log a + log b is equal to:",
          "options": [
            "log(a + b)",
            "(log a)(log b)",
            "log(ab)",
            "log(a/b)"
          ],
          "answer": 2,
          "explanation": "Adding logs corresponds to multiplying the numbers.",
          "terms": [
            "math-ai-1.5-law-of-logs"
          ]
        },
        {
          "id": "math-ai-1.5-3-q02",
          "type": "mcq",
          "prompt": "Evaluate 8^(2/3).",
          "options": [
            "2",
            "4",
            "16",
            "64"
          ],
          "answer": 1,
          "explanation": "8^(2/3) = (∛8)² = 2² = 4.",
          "terms": [
            "math-ai-1.5-rational-exponent"
          ]
        },
        {
          "id": "math-ai-1.5-3-q03",
          "type": "fill",
          "text": "log₃ 81 = ___",
          "answer": "4",
          "bank": [
            "4",
            "27",
            "3",
            "9"
          ],
          "explanation": "3⁴ = 81.",
          "terms": [
            "math-ai-1.5-law-of-logs"
          ]
        },
        {
          "id": "math-ai-1.5-3-q04",
          "type": "tf",
          "statement": "log(a + b) = log a + log b.",
          "answer": false,
          "explanation": "There is no law for the log of a sum; log a + log b = log(ab).",
          "terms": [
            "math-ai-1.5-law-of-logs"
          ]
        },
        {
          "id": "math-ai-1.5-3-q05",
          "type": "mcq",
          "prompt": "Solve 3^(2x) = 20, giving x to 3 s.f.",
          "options": [
            "2.73",
            "1.50",
            "1.36",
            "0.732"
          ],
          "answer": 2,
          "explanation": "Take logs: 2x ln 3 = ln 20, so x = ln 20 / (2 ln 3) ≈ 1.36.",
          "terms": [
            "math-ai-1.5-law-of-logs"
          ]
        },
        {
          "id": "math-ai-1.5-3-q06",
          "type": "match",
          "prompt": "Match each expression to an equivalent form.",
          "pairs": [
            {
              "left": "log(xⁿ)",
              "right": "n log x"
            },
            {
              "left": "log(x/y)",
              "right": "log x − log y"
            },
            {
              "left": "logₐ a",
              "right": "1"
            },
            {
              "left": "logₐ 1",
              "right": "0"
            }
          ],
          "explanation": "These follow from the laws of exponents.",
          "terms": [
            "math-ai-1.5-law-of-logs"
          ]
        },
        {
          "id": "math-ai-1.5-3-q07",
          "type": "fill",
          "text": "x^(1/n) means the ___ root of x.",
          "answer": "nth",
          "bank": [
            "nth",
            "square",
            "reciprocal",
            "negative"
          ],
          "explanation": "For example 27^(1/3) = ∛27 = 3.",
          "terms": [
            "math-ai-1.5-rational-exponent"
          ]
        },
        {
          "id": "math-ai-1.5-3-q08",
          "type": "mcq",
          "prompt": "Simplify (16x⁸)^(3/4).",
          "options": [
            "12x⁶",
            "64x⁶",
            "8x^(32/3)",
            "8x⁶"
          ],
          "answer": 3,
          "explanation": "16^(3/4) = (⁴√16)³ = 8 and (x⁸)^(3/4) = x⁶.",
          "terms": [
            "math-ai-1.5-rational-exponent"
          ]
        },
        {
          "id": "math-ai-1.5-3-q09",
          "type": "tf",
          "statement": "2 log 5 + log 4 = 2, where log means log₁₀.",
          "answer": true,
          "explanation": "2 log 5 + log 4 = log 25 + log 4 = log 100 = 2.",
          "terms": [
            "math-ai-1.5-law-of-logs"
          ]
        },
        {
          "id": "math-ai-1.5-3-q10",
          "type": "mcq",
          "prompt": "Evaluate log₂ 10 to 3 s.f.",
          "options": [
            "5.00",
            "3.32",
            "0.301",
            "20.0"
          ],
          "answer": 1,
          "explanation": "Change of base: log₂ 10 = log 10 / log 2 = 1/0.30103 ≈ 3.32.",
          "terms": [
            "math-ai-1.5-change-of-base"
          ]
        }
      ]
    }
  ]
}
