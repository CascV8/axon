          "terms": [
            "math-ai-3.1-bearing"
          ]
        },
        {
          "id": "math-ai-3.1-2-q07",
          "type": "mcq",
          "prompt": "The bearing of A from B is 070°. Find the bearing of B from A.",
          "options": [
            "110°",
            "290°",
            "070°",
            "250°"
          ],
          "answer": 3,
          "explanation": "Back bearings differ by 180°: 070° + 180° = 250°.",
          "terms": [
            "math-ai-3.1-bearing"
          ]
        },
        {
          "id": "math-ai-3.1-2-q08",
          "type": "match",
          "prompt": "Match the information given to the best method.",
          "pairs": [
