{
  "id": "math-ai-3.1",
  "code": "SL 3.1–3.4, AHL 3.7–3.8",
  "unit": "3",
  "title": "3D geometry and trigonometry",
  "level": "SL",
  "summary": "Volumes, surface areas and distances in 3D, arcs and sectors, and solving triangles with the sine and cosine rules, bearings and elevation. HL adds radians, the unit circle and trigonometric equations.",
  "keyterms": [
    {
      "id": "math-ai-3.1-volume",
      "term": "Volume",
      "definition": "The space a 3D solid occupies, e.g. cone ⅓πr²h, sphere ⁴⁄₃πr³.",
      "hl": false
    },
    {
      "id": "math-ai-3.1-surface-area",
      "term": "Surface area",
      "definition": "The total area of all faces or curved surfaces of a solid, e.g. sphere 4πr².",
      "hl": false
    },
    {
      "id": "math-ai-3.1-distance-3d",
      "term": "Distance in 3D",
      "definition": "√((x₁ − x₂)² + (y₁ − y₂)² + (z₁ − z₂)²) between two points.",
      "hl": false
    },
    {
      "id": "math-ai-3.1-line-plane-angle",
      "term": "Angle between a line and a plane",
      "definition": "The angle between the line and its projection onto the plane.",
      "hl": false
    },
    {
      "id": "math-ai-3.1-sine-rule",
      "term": "Sine rule",
      "definition": "a/sin A = b/sin B = c/sin C, used with two angles and a side.",
      "hl": false
    },
    {
      "id": "math-ai-3.1-cosine-rule",
      "term": "Cosine rule",
      "definition": "c² = a² + b² − 2ab cos C, used with two sides and the included angle, or three sides.",
      "hl": false
    },
    {
      "id": "math-ai-3.1-triangle-area",
      "term": "Area of a triangle",
      "definition": "A = ½ab sin C, using two sides and the angle between them.",
      "hl": false
    },
    {
      "id": "math-ai-3.1-angle-of-elevation",
      "term": "Angle of elevation",
      "definition": "The angle measured upward from the horizontal to a line of sight.",
      "hl": false
    },
    {
      "id": "math-ai-3.1-angle-of-depression",
      "term": "Angle of depression",
      "definition": "The angle measured downward from the horizontal to a line of sight.",
      "hl": false
    },
    {
      "id": "math-ai-3.1-bearing",
      "term": "Bearing",
      "definition": "A direction given as a three-figure angle measured clockwise from north.",
      "hl": false
    },
    {
      "id": "math-ai-3.1-arc-length",
      "term": "Arc length",
      "definition": "The length of part of a circle: (θ/360°) × 2πr, or rθ with θ in radians.",
      "hl": false
    },
    {
      "id": "math-ai-3.1-sector-area",
      "term": "Area of a sector",
      "definition": "(θ/360°) × πr², or ½r²θ with θ in radians.",
      "hl": false
    },
    {
      "id": "math-ai-3.1-radian",
      "term": "Radian",
      "definition": "The angle subtended by an arc equal in length to the radius; π rad = 180°.",
      "hl": true
    },
    {
      "id": "math-ai-3.1-unit-circle",
      "term": "Unit circle",
      "definition": "A circle of radius 1 centred at the origin; the point at angle θ is (cos θ, sin θ).",
      "hl": true
    },
    {
      "id": "math-ai-3.1-pythagorean-identity",
      "term": "Pythagorean identity",
      "definition": "sin²θ + cos²θ = 1 for every angle θ.",
      "hl": true
    }
  ],
  "lessons": [
    {
      "id": "math-ai-3.1-1",
      "title": "Solids, distances, arcs and sectors",
      "hl": false,
      "questions": [
        {
          "id": "math-ai-3.1-1-q01",
          "type": "mcq",
          "prompt": "Find the volume of a cone with radius 3 cm and height 4 cm.",
          "options": [
            "113 cm³",
            "50.3 cm³",
            "37.7 cm³",
            "28.3 cm³"
          ],
          "answer": 2,
          "explanation": "V = ⅓π(3²)(4) = 12π ≈ 37.7 cm³. 113 cm³ forgets the ⅓.",
          "terms": [
            "math-ai-3.1-volume"
          ]
        },
        {
          "id": "math-ai-3.1-1-q02",
          "type": "fill",
          "text": "The distance between (1, 2, 3) and (4, 6, 3) is ___.",
          "answer": "5",
          "bank": [
            "7",
            "5",
            "25",
            "12"
          ],
          "explanation": "√(3² + 4² + 0²) = √25 = 5.",
          "terms": [
            "math-ai-3.1-distance-3d"
          ]
        },
        {
          "id": "math-ai-3.1-1-q03",
          "type": "tf",
          "statement": "The surface area of a sphere of radius r is 4πr².",
          "answer": true,
          "explanation": "This is in the formula booklet; volume is ⁴⁄₃πr³.",
          "terms": [
            "math-ai-3.1-surface-area"
          ]
        },
        {
          "id": "math-ai-3.1-1-q04",
          "type": "mcq",
          "prompt": "Find the midpoint of (2, −1, 4) and (6, 3, 0).",
          "options": [
            "(8, 2, 4)",
            "(2, 2, −2)",
            "(4, 2, 2)",
            "(4, 1, 2)"
          ],
          "answer": 3,
          "explanation": "Average each coordinate: ((2 + 6)/2, (−1 + 3)/2, (4 + 0)/2).",
          "terms": [
            "math-ai-3.1-distance-3d"
          ]
        },
        {
          "id": "math-ai-3.1-1-q05",
          "type": "mcq",
          "prompt": "A cuboid is 6 cm × 4 cm × 3 cm. Find the angle between a space diagonal and the base.",
          "options": [
            "26.6°",
            "30.0°",
            "22.6°",
            "36.9°"
          ],
          "answer": 2,
          "explanation": "Base diagonal = √(6² + 4²) = √52; tan θ = 3/√52, θ ≈ 22.6°.",
          "terms": [
            "math-ai-3.1-line-plane-angle"
          ]
        },
        {
          "id": "math-ai-3.1-1-q06",
          "type": "mcq",
          "prompt": "Find the length of an arc of radius 10 cm subtending 72° at the centre.",
          "options": [
            "62.8 cm",
            "12.6 cm",
            "25.1 cm",
            "7.2 cm"
          ],
          "answer": 1,
          "explanation": "(72/360) × 2π × 10 ≈ 12.6 cm.",
          "terms": [
            "math-ai-3.1-arc-length"
          ]
        },
        {
          "id": "math-ai-3.1-1-q07",
          "type": "mcq",
          "prompt": "Find the area of a sector of radius 6 cm with angle 50°.",
          "options": [
            "15.7 cm²",
            "31.4 cm²",
            "5.24 cm²",
            "18.0 cm²"
          ],
          "answer": 0,
          "explanation": "(50/360) × π × 6² ≈ 15.7 cm².",
          "terms": [
            "math-ai-3.1-sector-area"
          ]
        },
        {
          "id": "math-ai-3.1-1-q08",
          "type": "tf",
          "statement": "A sphere of radius 3 cm has volume 36π cm³.",
          "answer": true,
          "explanation": "⁴⁄₃π × 27 = 36π.",
          "terms": [
            "math-ai-3.1-volume"
          ]
        },
        {
          "id": "math-ai-3.1-1-q09",
          "type": "match",
          "prompt": "Match each solid to its volume formula.",
          "pairs": [
            {
              "left": "Cylinder",
              "right": "πr²h"
            },
            {
              "left": "Cone",
              "right": "⅓πr²h"
            },
            {
              "left": "Sphere",
              "right": "⁴⁄₃πr³"
            },
            {
              "left": "Square-based pyramid, side a",
              "right": "⅓a²h"
            }
          ],
          "explanation": "Cones and pyramids hold one third of the matching prism or cylinder.",
          "terms": [
            "math-ai-3.1-volume"
          ]
        },
        {
          "id": "math-ai-3.1-1-q10",
          "type": "order",
          "prompt": "Order these solids by volume, smallest first.",
          "items": [
            "Cone, r = 3, h = 3",
            "Sphere, r = 2",
            "Cylinder, r = 2, h = 3",
            "Cube, side 4"
          ],
          "explanation": "Volumes: 9π ≈ 28.3, 32π/3 ≈ 33.5, 12π ≈ 37.7, 64.",
          "terms": [
            "math-ai-3.1-volume"
          ]
        }
      ]
    },
    {
      "id": "math-ai-3.1-2",
      "title": "Solving triangles, bearings and elevation",
      "hl": false,
      "questions": [
        {
          "id": "math-ai-3.1-2-q01",
          "type": "mcq",
          "prompt": "In triangle ABC, A = 40°, B = 65° and a = 8 cm. Find b.",
          "options": [
            "5.67 cm",
            "11.3 cm",
            "7.53 cm",
            "13.0 cm"
          ],
          "answer": 1,
          "explanation": "Sine rule: b = 8 sin 65° / sin 40° ≈ 11.3 cm.",
          "terms": [
            "math-ai-3.1-sine-rule"
          ]
        },
        {
          "id": "math-ai-3.1-2-q02",
          "type": "mcq",
          "prompt": "a = 7, b = 9 and C = 60°. Find c.",
          "options": [
            "8.19",
            "11.4",
            "4.47",
            "67"
          ],
          "answer": 0,
          "explanation": "c² = 49 + 81 − 2(7)(9) cos 60° = 67, so c ≈ 8.19.",
          "terms": [
            "math-ai-3.1-cosine-rule"
          ]
        },
        {
          "id": "math-ai-3.1-2-q03",
          "type": "fill",
          "text": "A triangle has sides 5 cm and 8 cm with 30° between them. Its area is ___ cm².",
