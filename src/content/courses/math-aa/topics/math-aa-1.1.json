{
  "id": "math-aa-1.1",
  "code": "SL 1.1–1.3, 1.8",
  "unit": "1",
  "title": "Sequences, series and standard form",
  "level": "SL",
  "summary": "Write numbers in standard form, then find terms and sums of arithmetic and geometric sequences, including the sum to infinity of a convergent geometric series.",
  "keyterms": [
    {
      "id": "math-aa-1.1-scientific-notation",
      "term": "Scientific notation",
      "definition": "Writing a number as a × 10ᵏ with 1 ≤ a < 10 and k an integer (also called standard form).",
      "hl": false
    },
    {
      "id": "math-aa-1.1-arithmetic-sequence",
      "term": "Arithmetic sequence",
      "definition": "A sequence in which each term is the previous term plus a constant: uₙ = u₁ + (n − 1)d.",
      "hl": false
    },
    {
      "id": "math-aa-1.1-common-difference",
      "term": "Common difference",
      "definition": "The constant d added to get from one term of an arithmetic sequence to the next: d = uₙ₊₁ − uₙ.",
      "hl": false
    },
    {
      "id": "math-aa-1.1-geometric-sequence",
      "term": "Geometric sequence",
      "definition": "A sequence in which each term is the previous term multiplied by a constant: uₙ = u₁rⁿ⁻¹.",
      "hl": false
    },
    {
      "id": "math-aa-1.1-common-ratio",
      "term": "Common ratio",
      "definition": "The constant r that multiplies each term of a geometric sequence to give the next: r = uₙ₊₁ / uₙ.",
      "hl": false
    },
    {
      "id": "math-aa-1.1-series",
      "term": "Series",
      "definition": "The sum of the terms of a sequence, e.g. u₁ + u₂ + u₃ + ….",
      "hl": false
    },
    {
      "id": "math-aa-1.1-sigma-notation",
      "term": "Sigma notation",
      "definition": "Compact notation for a sum: ∑ₖ₌₁ⁿ uₖ means u₁ + u₂ + … + uₙ.",
      "hl": false
    },
    {
      "id": "math-aa-1.1-partial-sum",
      "term": "Partial sum",
      "definition": "Sₙ, the sum of the first n terms of a sequence.",
      "hl": false
    },
    {
      "id": "math-aa-1.1-convergent-series",
      "term": "Convergent series",
      "definition": "An infinite series whose partial sums approach a finite limit; a geometric series converges when |r| < 1.",
      "hl": false
    },
    {
      "id": "math-aa-1.1-sum-to-infinity",
      "term": "Sum to infinity",
      "definition": "The limit of Sₙ as n → ∞; for a geometric series with |r| < 1, S∞ = u₁ / (1 − r).",
      "hl": false
    }
  ],
  "lessons": [
    {
      "id": "math-aa-1.1-1",
      "title": "Standard form and arithmetic sequences",
      "hl": false,
      "questions": [
        {
          "id": "math-aa-1.1-1-q01",
          "type": "mcq",
          "prompt": "Write 0.000 307 in the form a × 10ᵏ, where 1 ≤ a < 10 and k ∈ ℤ.",
          "options": [
            "30.7 × 10⁻⁵",
            "3.07 × 10⁻⁴",
            "3.07 × 10⁴",
            "3.07 × 10⁻³"
          ],
          "answer": 1,
          "explanation": "Move the decimal point 4 places right to get 3.07, so the power is −4. 30.7 × 10⁻⁵ has the right value but a is not between 1 and 10.",
          "terms": [
            "math-aa-1.1-scientific-notation"
          ]
        },
        {
          "id": "math-aa-1.1-1-q02",
          "type": "mcq",
          "prompt": "An arithmetic sequence has u₁ = 5 and d = 3. Find u₂₀.",
          "options": [
            "57",
            "65",
            "62",
            "60"
          ],
          "answer": 2,
          "explanation": "u₂₀ = u₁ + 19d = 5 + 57 = 62. Using 20d instead of 19d is the classic slip.",
          "terms": [
            "math-aa-1.1-arithmetic-sequence",
            "math-aa-1.1-common-difference"
          ]
        },
        {
          "id": "math-aa-1.1-1-q03",
          "type": "fill",
          "text": "The common difference of 11, 7, 3, −1, … is ___.",
          "answer": "−4",
          "accept": [
            "-4"
          ],
          "bank": [
            "4",
            "−4",
            "−3",
            "−8"
          ],
          "explanation": "d = u₂ − u₁ = 7 − 11 = −4. A decreasing arithmetic sequence has a negative common difference.",
          "terms": [
            "math-aa-1.1-common-difference"
          ]
        },
        {
          "id": "math-aa-1.1-1-q04",
          "type": "mcq",
          "prompt": "Find the sum of the first 10 terms of 2, 5, 8, 11, ….",
          "options": [
            "29",
            "170",
            "145",
            "155"
          ],
          "answer": 3,
          "explanation": "S₁₀ = 10/2 × (2 × 2 + 9 × 3) = 5 × 31 = 155. 29 is u₁₀, not the sum.",
          "terms": [
            "math-aa-1.1-partial-sum",
            "math-aa-1.1-arithmetic-sequence"
          ]
        },
        {
          "id": "math-aa-1.1-1-q05",
          "type": "tf",
          "statement": "In an arithmetic sequence, uₙ = u₁ + nd.",
          "answer": false,
          "explanation": "The nth term is u₁ + (n − 1)d: you add d only n − 1 times to get from the first term to the nth.",
          "terms": [
            "math-aa-1.1-arithmetic-sequence"
          ]
        },
        {
          "id": "math-aa-1.1-1-q06",
          "type": "mcq",
          "prompt": "In an arithmetic sequence, u₃ = 10 and u₇ = 26. Find u₁.",
          "options": [
            "2",
            "4",
            "−2",
            "6"
          ],
          "answer": 0,
          "explanation": "u₇ − u₃ = 4d = 16, so d = 4. Then u₁ = u₃ − 2d = 10 − 8 = 2.",
          "terms": [
            "math-aa-1.1-arithmetic-sequence",
            "math-aa-1.1-common-difference"
          ]
        },
        {
          "id": "math-aa-1.1-1-q07",
          "type": "fill",
          "text": "∑ₖ₌₁⁴ (2k + 1) = ___",
          "answer": "24",
          "bank": [
            "25",
            "24",
            "20",
            "16"
          ],
          "explanation": "Substitute k = 1, 2, 3, 4: 3 + 5 + 7 + 9 = 24.",
          "terms": [
            "math-aa-1.1-sigma-notation",
            "math-aa-1.1-series"
          ]
        },
        {
          "id": "math-aa-1.1-1-q08",
          "type": "match",
          "prompt": "Match each formula to what it gives.",
          "pairs": [
            {
              "left": "uₙ = u₁ + (n − 1)d",
              "right": "nth term of an arithmetic sequence"
            },
            {
              "left": "Sₙ = n/2 (u₁ + uₙ)",
              "right": "sum of the first n arithmetic terms"
            },
            {
              "left": "uₙ = u₁rⁿ⁻¹",
              "right": "nth term of a geometric sequence"
            },
            {
              "left": "S∞ = u₁ / (1 − r)",
              "right": "geometric sum to infinity, when |r| < 1"
            }
          ],
          "explanation": "These four formulae are in the formula booklet; knowing which one fits the question is the skill.",
          "terms": [
            "math-aa-1.1-arithmetic-sequence",
            "math-aa-1.1-geometric-sequence",
            "math-aa-1.1-sum-to-infinity"
          ]
        },
        {
          "id": "math-aa-1.1-1-q09",
          "type": "order",
          "prompt": "Put the steps in order to find how many terms 7, 11, 15, …, 207 has.",
          "items": [
            "Identify u₁ = 7 and d = 4",
            "Set 7 + (n − 1) × 4 = 207",
            "Solve 4(n − 1) = 200",
            "Conclude n = 51"
          ],
          "explanation": "Setting the general term equal to the last term gives an equation in n; n − 1 = 50, so there are 51 terms.",
          "terms": [
            "math-aa-1.1-arithmetic-sequence"
          ]
        },
        {
          "id": "math-aa-1.1-1-q10",
          "type": "tf",
          "statement": "(1.2 × 10³) × (5 × 10⁻⁵) = 6 × 10⁻²",
          "answer": true,
          "explanation": "Multiply the numbers (1.2 × 5 = 6) and add the powers (3 + (−5) = −2).",
          "terms": [
            "math-aa-1.1-scientific-notation"
          ]
        }
      ]
    },
    {
      "id": "math-aa-1.1-2",
      "title": "Geometric sequences and sums to infinity",
      "hl": false,
      "questions": [
        {
          "id": "math-aa-1.1-2-q01",
          "type": "mcq",
          "prompt": "Find u₈ for the geometric sequence 3, 6, 12, ….",
          "options": [
            "24",
            "192",
            "384",
            "768"
          ],
          "answer": 2,
          "explanation": "r = 2, so u₈ = 3 × 2⁷ = 3 × 128 = 384. 768 uses 2⁸ by mistake.",
          "terms": [
            "math-aa-1.1-geometric-sequence",
            "math-aa-1.1-common-ratio"
          ]
        },
        {
          "id": "math-aa-1.1-2-q02",
          "type": "mcq",
          "prompt": "Find S₅ for the geometric series 2 + 6 + 18 + ….",
          "options": [
            "80",
            "242",
            "162",
            "484"
          ],
          "answer": 1,
          "explanation": "S₅ = 2(3⁵ − 1)/(3 − 1) = 2 × 242 / 2 = 242. Check: 2 + 6 + 18 + 54 + 162 = 242. 162 is u₅.",
          "terms": [
            "math-aa-1.1-partial-sum",
            "math-aa-1.1-geometric-sequence"
          ]
        },
        {
          "id": "math-aa-1.1-2-q03",
          "type": "tf",
          "statement": "The series 8 + 4 + 2 + 1 + … converges to 16.",
          "answer": true,
          "explanation": "r = ½, so S∞ = 8 / (1 − ½) = 16.",
          "terms": [
            "math-aa-1.1-convergent-series",
            "math-aa-1.1-sum-to-infinity"
          ]
        },
        {
          "id": "math-aa-1.1-2-q04",
          "type": "fill",
          "text": "The sum to infinity of a geometric series exists only when |r| ___ 1.",
          "answer": "<",
          "bank": [
            "=",
            ">",
            "≥",
            "<"
          ],
          "explanation": "Only when |r| < 1 do the terms shrink fast enough for the partial sums to approach a limit.",
          "terms": [
            "math-aa-1.1-convergent-series",
            "math-aa-1.1-common-ratio"
          ]
        },
        {
          "id": "math-aa-1.1-2-q05",
          "type": "mcq",
          "prompt": "Find the sum to infinity of 27 − 9 + 3 − 1 + ….",
          "options": [
            "13.5",
            "36",
            "20.25",
            "40.5"
          ],
          "answer": 2,
          "explanation": "r = −⅓, so S∞ = 27 / (1 + ⅓) = 27 × ¾ = 20.25. Using r = +⅓ gives 40.5.",
          "terms": [
            "math-aa-1.1-sum-to-infinity",
            "math-aa-1.1-common-ratio"
          ]
        },
        {
          "id": "math-aa-1.1-2-q06",
          "type": "mcq",
          "prompt": "For which common ratio does a geometric series have a sum to infinity?",
          "options": [
            "r = −1",
            "r = −2",
            "r = 0.9",
            "r = 1.1"
          ],
          "answer": 2,
          "explanation": "The condition is |r| < 1; only 0.9 satisfies it. r = −1 makes the partial sums oscillate.",
          "terms": [
            "math-aa-1.1-convergent-series"
          ]
        },
        {
          "id": "math-aa-1.1-2-q07",
          "type": "fill",
          "text": "If u₁ = 5 and r = 0.2, then S∞ = ___.",
          "answer": "6.25",
          "bank": [
            "25",
            "4",
            "6.25",
            "1"
          ],
          "explanation": "S∞ = 5 / (1 − 0.2) = 5 / 0.8 = 6.25.",
          "terms": [
            "math-aa-1.1-sum-to-infinity"
          ]
        },
        {
          "id": "math-aa-1.1-2-q08",
          "type": "match",
          "prompt": "Classify each sequence.",
          "pairs": [
            {
              "left": "4, 9, 14, 19, …",
              "right": "Arithmetic, d = 5"
            },
            {
              "left": "4, 12, 36, 108, …",
              "right": "Geometric, r = 3"
            },
            {
              "left": "100, 50, 25, 12.5, …",
              "right": "Geometric, r = 0.5"
            },
            {
              "left": "4, 1, −2, −5, …",
              "right": "Arithmetic, d = −3"
            }
          ],
          "explanation": "Check differences first (constant → arithmetic), then ratios (constant → geometric).",
          "terms": [
            "math-aa-1.1-arithmetic-sequence",
            "math-aa-1.1-geometric-sequence"
          ]
        },
        {
          "id": "math-aa-1.1-2-q09",
          "type": "order",
          "prompt": "Order these values from smallest to largest.",
          "items": [
            "S∞ of 2 + 1 + ½ + …",
            "u₁₀ of 1, 3, 5, …",
            "S₄ of 1 + 3 + 9 + …"
          ],
          "explanation": "S∞ = 2/(1 − ½) = 4; u₁₀ = 1 + 9 × 2 = 19; S₄ = 1 + 3 + 9 + 27 = 40.",
          "terms": [
            "math-aa-1.1-sum-to-infinity",
            "math-aa-1.1-partial-sum"
          ]
        },
        {
          "id": "math-aa-1.1-2-q10",
          "type": "tf",
          "statement": "A geometric sequence with r = −2 has terms that alternate in sign.",
          "answer": true,
          "explanation": "Multiplying by a negative number each time flips the sign, e.g. 1, −2, 4, −8, ….",
          "terms": [
            "math-aa-1.1-common-ratio"
          ]
        }
      ]
    }
  ]
}
